    <CheatEntry>
      <ID>974</ID>
      <Description>"Full View Mode"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

luacall(function cycleFullCompact(sender,force); local state = not(compactmenuitem.Caption == 'Compact View Mode'); if force~=nil then state = not force end; compactmenuitem.Caption = state and 'Compact View Mode' or 'Full view Mode'; getMainForm().Splitter1.Visible = state; getMainForm().Panel4.Visible = state; getMainForm().Panel5.Visible = state; end; function addCompactMenu(); if compactmenualreadyexists then return end; local parent = getMainForm().Menu.Items; compactmenuitem = createMenuItem(parent); parent.add(compactmenuitem); compactmenuitem.Caption = 'Compact View Mode'; compactmenuitem.OnClick = cycleFullCompact; compactmenualreadyexists = 'yes'; end; addCompactMenu(); cycleFullCompact(nil,true))

[DISABLE]

luacall(cycleFullCompact(nil,false))

</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>105582</ID>
      <Description>"Disable Time"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(TimeStop,$Process,83 B9 00 02 00 00 00 0F 9F C0 C3)
alloc(newmem,$100,TimeStop)
label(code)
label(return)
label(TimeStopON)
label(TimeStopOFF)
registersymbol(TimeStop)
registersymbol(TimeStopON)
registersymbol(TimeStopOFF)

newmem:
  cmp [TimeStopON],0
  je TimeStopOFF
  mov [rcx+00000200],01
  jmp code

TimeStopOFF:
  mov [rcx+00000200],00
  jmp code

code:
  cmp dword ptr [rcx+00000200],00
  jmp return

TimeStopON:
  dq 0

TimeStop:
  jmp newmem
  nop 2
return:

[DISABLE]
TimeStop:
  db 83 B9 00 02 00 00 00

unregistersymbol(*)
dealloc(*)

{
// ---------- INJECTING HERE ----------
ProjectCoral-Win64-Shipping.UCurveLinearColor::HasAnyAlphaKeys: 83 B9 00 02 00 00 00  - cmp dword ptr [rcx+00000200],00
// ---------- DONE INJECTING  ----------
ProjectCoral-Win64-Shipping.UCurveLinearColor::HasAnyAlphaKeys+7: 0F 9F C0              - setg al
ProjectCoral-Win64-Shipping.UCurveLinearColor::HasAnyAlphaKeys+A: C3                    - ret
}
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>105586</ID>
          <Description>"Time Stop On/Off"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
TimeStopON:
 dd 1

[DISABLE]
TimeStopON:
 dd 0
</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
    <CheatEntry>
      <ID>9393</ID>
      <Description>"Infinite Health and Stamina"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(InfiniteStaminaAndHealth,$Process,F3 0F 11 89 B0 00 00 00 E9 AF)
alloc(newmem,$100,InfiniteStaminaAndHealth)
label(code)
label(return)
registersymbol(InfiniteStaminaAndHealth)

newmem:
  cmp [rcx+C8],#0             // 0 = Enemies
  je code
  movss [rcx+000000B0],xmm2   //Health and Stamina no decrease
  jmp return

code:
  movss [rcx+000000B0],xmm1
  jmp return

InfiniteStaminaAndHealth:
  jmp newmem
  nop 3
return:

[DISABLE]
InfiniteStaminaAndHealth:
  db F3 0F 11 89 B0 00 00 00

unregistersymbol(*)
dealloc(*)

{
// ---------- INJECTING HERE ----------
ProjectCoral-Win64-Shipping.UC_FillableStatisticComponent::RemoveAmount+34: F3 0F 11 89 B0 00 00 00  - movss [rcx+000000B0],xmm1
// ---------- DONE INJECTING  ----------
}
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>9</ID>
      <Description>"Highlighted Item (only have ID for No Rarity Items)"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(InventoryAob,$Process,8B 41 08 48 8B D9 89 42)
alloc(newmem,$100,InventoryAob)
label(code)
label(return)
label(ItemPtr)
registersymbol(InventoryAob)
registersymbol(ItemPtr)

newmem:
  mov [ItemPtr],rcx

code:
  mov eax,[rcx+08]
  mov rbx,rcx
  jmp return

ItemPtr:
  dq 0

InventoryAob:
  jmp newmem
  nop
return:

[DISABLE]
