    <CheatEntry>
      <ID>9394</ID>
      <Description>"Find Money (Open and Close Inventory)"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(FindMoney,$Process,8B 80 B8 00 00 00 48 83 C4 20 5B C3 48)
alloc(newmem,$100,FindMoney)
label(code)
label(return)
label(MoneyValue)
registersymbol(FindMoney)
registersymbol(MoneyValue)

newmem:
  mov [MoneyValue],rax

code:
  mov eax,[rax+000000B8]
  jmp return

MoneyValue:
  dd 0

FindMoney:
  jmp newmem
  nop
return:

[DISABLE]
FindMoney:
  db 8B 80 B8 00 00 00

unregistersymbol(*)
dealloc(*)

{
// ---------- INJECTING HERE ----------
ProjectCoral-Win64-Shipping.UC_MainHUDWidget::GetCurrentRealGold+27: 8B 80 B8 00 00 00     - mov eax,[rax+000000B8]
// ---------- DONE INJECTING  ----------
}
</AssemblerScript>
