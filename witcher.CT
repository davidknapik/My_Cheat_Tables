  <CheatEntries>
    <CheatEntry>
      <ID>3</ID>
      <Description>"Endurance"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>// Endurance: Float
//

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
aobscanmodule(aob_endurance, witcher.exe, 83 F8 01 75 1A F3 0F 11 81 AC 01 00 00 8B 49 10 )
registersymbol(aob_endurance)

aob_endurance+5:
db 90 90 90 90 90 90 90 90



 /*
witcher.exe+37B4A6:
0077B4A1 - 83 F8 01 - cmp eax,01
0077B4A4 - 75 1A - jne witcher.exe+37B4C0
0077B4A6 - F3 0F11 81 AC010000  - movss [ecx+000001AC],xmm0 &lt;&lt;
0077B4AE - 8B 49 10  - mov ecx,[ecx+10]
0077B4B1 - 85 C9  - test ecx,ecx
 */

 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
aob_endurance+5:
db F3 0F 11 81 AC 01 00 00
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>6</ID>
      <Description>"Inventory"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>// Inventory: 4byte
// Split stack with Ctrl-Left Click and place item in inventory

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
aobscanmodule(aob_inventory, witcher.exe, 85 F6 74 0C 29 9F 24 04 00 00 89 9E 24 04 00 00 8B C6 )
registersymbol(aob_inventory)

aob_inventory+4:
// add [edi+00000424],ebx
db 90 90 90 90 90 90



 /*
witcher.exe+51682A:
00916826 - 85 F6  - test esi,esi
00916828 - 74 0C - je witcher.exe+516836
0091682A - 29 9F 24040000  - sub [edi+00000424],ebx &lt;&lt;
00916830 - 89 9E 24040000  - mov [esi+00000424],ebx
00916836 - 8B C6  - mov eax,esi
 */

 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
aob_inventory+4:
db 29 9F 24 04 00 00
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>8</ID>
      <Description>"Talents"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>// Talents: 4byte
// Spend point and return

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
aobscanmodule(aob_talents, witcher.exe, 8B 54 24 78 8B 74 24 7C 8B BC 24 80 00 00 00 2B CA )
registersymbol(aob_talents)

aob_talents+f:
// add [edi+00000424],ebx
db 90 90



 /*
witcher.exe+385EC7 - 8B 88 94020000        - mov ecx,[eax+00000294]
witcher.exe+385ECD - 8B 54 24 78           - mov edx,[esp+78]
witcher.exe+385ED1 - 8B 74 24 7C           - mov esi,[esp+7C]
witcher.exe+385ED5 - 8B BC 24 80000000     - mov edi,[esp+00000080]
witcher.exe+385EDC - 2B CA                 - sub ecx,edx     &lt;&lt;&lt;&lt;&lt;&lt; Copper Talent
witcher.exe+385EDE - 89 88 94020000        - mov [eax+00000294],ecx
witcher.exe+385EE4 - 8B 88 98020000        - mov ecx,[eax+00000298]
witcher.exe+385EEA - 2B CE                 - sub ecx,esi
witcher.exe+385EEC - 89 88 98020000        - mov [eax+00000298],ecx
witcher.exe+385EF2 - 8B 88 9C020000        - mov ecx,[eax+0000029C]
witcher.exe+385EF8 - 2B CF                 - sub ecx,edi
witcher.exe+385EFA - 89 88 9C020000        - mov [eax+0000029C],ecx
witcher.exe+385F00 - 01 15 B463EE00        - add [witcher.exe+AE63B4],edx { (0) }

 */

 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
aob_talents+f:
db 2B CA
</AssemblerScript>
    </CheatEntry>
