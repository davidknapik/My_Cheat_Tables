          <ID>645</ID>
          <Description>"finding ignore reload"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : X4.exe
  Version: 
  Date   : 2024-07-06
  Author : jacke

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(INJECT_MISSILE_RELOAD,X4.exe,84 C0 0F 84 B0 01 00 00 48 8D) // should be unique
alloc(newmem,$1000,INJECT_MISSILE_RELOAD)

label(original)
label(return)
label(lock)

newmem:
  push rax
  cmp rbx, [pPlayer]
  je lock
  cmp rdi, [pPlayer]
  je lock
  cmp r11, [pPlayer]
  je lock
  cmp r12, [pPlayer]
  je lock
  cmp r15, [pPlayer]
  je lock
  mov rax, 2062489F520
  cmp rbx, rax
  je lock
  cmp rdi, rax
  je lock
  cmp r11, rax
  je lock
  cmp r12, rax
  je lock
  cmp r15, rax
  je lock
  pop rax
  jmp original

lock:
  pop rax

original:
  test al,al
  je X4.exe+118091B
  jmp return

INJECT_MISSILE_RELOAD:
  jmp newmem
  nop 3
return:
registersymbol(INJECT_MISSILE_RELOAD)

[DISABLE]

INJECT_MISSILE_RELOAD:
  db 84 C0 0F 84 B0 01 00 00

unregistersymbol(INJECT_MISSILE_RELOAD)
dealloc(newmem)

