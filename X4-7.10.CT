//=========================================
alloc(MyCode,4096,$process)
//=========================================
// Declaration section
label(_MonPlayerMoney)
label(_BackMPM)
label(_MonPlayerInfo)
label(_BackMPI)
label(_MonPlayerShip)
label(_BackMPS)
label(_GodMode)
label(_BackGMD)
label(_MonShipShield)
label(_BackMSS)
//label(_MonShipMissiles)
//label(_BackMSM)

label(iEnableMPM)
label(iEnableGMD)
label(iEnableMSS)
//label(iEnableMSM)

label(pMoney)
label(pPlayer)
label(pShip)
label(pShield)
label(pCommon)

label(iCount)

label(pMOPI)

label(aLast)

//=========================================
// Registering Symbols
registersymbol(MyCode)
registersymbol(iEnableMPM)
registersymbol(iEnableGMD)
registersymbol(iEnableMSS)
//registersymbol(iEnableMSM)
registersymbol(pMoney)
registersymbol(pPlayer)
registersymbol(pShip)
registersymbol(pShield)
registersymbol(pCommon)

registersymbol(MOPM)
registersymbol(pMOPI)
registersymbol(MOPS)
registersymbol(GDMD)
registersymbol(MOSS)
//registersymbol(MOSM)
registersymbol(MSS2)
//registersymbol(MSM2)

registersymbol(iCount)
registersymbol(aLast)

//=========================================
MyCode:
//========================================= 4.10 #
// All the time
_MonPlayerMoney:
 mov dword ptr [aLast],'_MPM'

 mov [pMoney],rcx

 cmp dword ptr [iEnableMPM],0
 je _ExitMPM                       // Jump if feature is disabled

 mov rax,[lMinMon]

 cmp [rcx+10],rax
 jns _ExitMPM

 mov [rcx+10],rax

_ExitMPM:
 mov rax,[rcx]                     // Original code
 call qword ptr [rax+08]           // Original code
 jmp _BackMPM                      // Back to main code

//========================================= 4.00 *
// All the time
_MonPlayerInfo:
 mov dword ptr [aLast],'_MPI'

 mov edi,[rax+08]
 cmp edi,'play'
 jne _ExitMPI

 mov [pPlayer],rax
 mov [pCommon],rax

_ExitMPI:
 mov edi,[rax+00000188]            // Original code
 jmp _BackMPI                      // Back to main code

//========================================= 5.10 *
// All the time
_MonPlayerShip:
 mov dword ptr [aLast],'_MPS'

 mov [pRSI],rsi
 mov [pRDI],rdi

 call qword ptr [rax+00001318]    // Original code
 mov r10,rax

 cmp rax,[pCommon]
 jne _ExitMPS

 mov rsi,[rcx+00000200]
 test rsi,rsi
 jz _ExitMPS

 cmp dword ptr [rcx+00000260],1
 js _ExitMPS

 cmp dword ptr [rcx+00000AE0],0
 je _ExitMPS

 lea rdi,[rcx+30]
 cmp rdi,[rcx+00000AE0]
 jne _MonPSZZ

_MonPSOK:
 mov rsi,[rcx+00000200]
 mov [pShield],rsi

 cmp rcx,[pShip]
 je _MonPSZZ

 lea rax,[rcx+000002B0]

 mov [pShip],rcx

 inc dword ptr [iCount]

_MonPSZZ:
 mov rax,[rcx+60]
 test rax,rax
 jz _ExitMPS

 mov rdi,[rax+18]
 test rdi,rdi
 jz _ExitMPS

 cmp dword ptr [iEnableGMD],0
 je _MonPS00                       // Jump if feature is disabled

 mov eax,[rdi+000002F8]

 cmp [rcx+000001F4],eax
 jns _MonPS00

 mov [rcx+000001F4],eax

_MonPS00:
 cmp dword ptr [iEnableMSS],0
 je _ExitMPS                       // Jump if feature is disabled

{$try}
 mov rax,[rsi]
 jmp short noerror10

{$except}
 xor rax,rax

noerror10:
 test rax,rax
 jz _ExitMPS

 mov eax,[rsi+34]

 cmp [rsi+58],eax
 jns _ExitMPS

 mov [rsi+58],eax

_ExitMPS:
 mov rsi,[pRSI]
 mov rdi,[pRDI]

 mov rax,r10

 jmp _BackMPS                      // Back to main code

//========================================= 5.10 #
// When updating Hull (including Wingman)
_GodMode:
 mov dword ptr [aLast],'_GMD'

 mov [pRBX],rbx

 cmp rdi,[pShip]
 je _GodMD00

{$try}
 mov rbx,[rdi+000002D0]
 jmp short noerror1

{$except}
 mov ebx,55555555

noerror1:
 cmp rbx,[pCommon]
 jne _ExitGMD

_GodMD00:
 cmp dword ptr [iEnableGMD],0
 je _ExitGMD                       // Jump if feature is disabled

 maxss xmm1,[rdi+000001F4]

_ExitGMD:
 mov rbx,[pRBX]

 movss [rdi+000001F4],xmm1         // Original code
 jmp _BackGMD                      // Back to main code

//========================================= 4.20 #
// When updating Shield (pending for the player's additinal ships)
_MonShipShield:
 mov dword ptr [aLast],'_MSS'

 cmp dword ptr [iEnableMSS],0
 je _ExitMSS                       // Jump if feature is disabled

 mov rax,[rcx+18]
 cmp rax,[pShield]
 je _MonSS00

 mov eax,[rsp+04]

 cmp eax,[rcx-28+04]
 jne _ExitMSS
 cmp eax,[rcx-20+04]
 jne _ExitMSS
 cmp eax,[rcx+08+04]
 jne _ExitMSS
 cmp eax,[rcx+10+04]
 jne _ExitMSS

 mov rax,[rcx+30]
 cmp rax,[pCommon]
 jne _ExitMSS

 mov eax,[rcx-3C]
 jmp _MonSS01
//--
_MonSS00:
 mov eax,[rax+34]

_MonSS01:
 cmp [rdx],eax
 jns _ExitMSS

 mov [rdx],eax

_ExitMSS:
 mov eax,[rdx]                     // Original code
 movsd [rcx-10],xmm2               // Original code
 jmp _BackMSS                      // Back to main code

//========================================= 4.20 X
// When decreasing Missiles
//_MonShipMissiles:
// mov dword ptr [aLast],'_MSM'
//
// mov [pRCX],rcx
//
// cmp dword ptr [iEnableMSM],0
