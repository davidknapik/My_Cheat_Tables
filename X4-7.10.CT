        <CheatEntry>
          <ID>133</ID>
          <Description>"Unlimited Deploys"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript Async="1">[ENABLE]
{$lua}
if syntaxcheck then return end
local memscan = createMemScan()
local found = createFoundList(memscan)
local bytes = "C6 ?? ?? ?? 00 45 33 C9 45 8D 41 01 49 8B ?? 49 8B ?? E8"
local start = getAddress(process)
local stop  = start + getModuleSize(process)
memscan.firstScan(
  soExactValue, vtByteArray, rtRounded,
  bytes, nil, start, stop, "+X-C-W",
  fsmNotAligned, "1", true, false, false, false)
memscan.waitTillDone()
found.initialize()
local i = 0
local count = found.Count - 1
for i = 0, count do
  local addr = found.Address[i]
  addr = tonumber(addr, 16) + 8
  registerSymbol("deploy"..i, addr, true)
end
memscan.Destroy()
memscan = nil

i = 0
local addr = getAddressSafe("deploy0")
while addr do
  writeByte(addr + 3, 0)
  i = i + 1
  addr = getAddressSafe("deploy"..i)
end

{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
local i = 0
local addr = getAddressSafe("deploy0")
while addr do
  writeByte(addr + 3, 1)
  i = i + 1
  addr = getAddressSafe("deploy"..i)
end
{$asm}

