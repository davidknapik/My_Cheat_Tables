    <CheatEntry>
      <ID>7</ID>
      <Description>"Scripts Using Custom Value Types"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

if not getCustomType("X4 - 4 Bytes") then
registerCustomTypeAutoAssembler([[
alloc(ConvertRoutine,1024)
alloc(ConvertBackRoutine,1024)
alloc(TypeName,256)
alloc(ByteSize,4)
alloc(UsesFloat,1)
alloc(UsesString,1)
alloc(MaxStringSize,2)
alloc(CallMethod,1)

TypeName:
db 'X4 - 4 Bytes',0
ByteSize:
dd #16
UsesFloat:
db 0
UsesString:
db 0
MaxStringSize:
dw #100
CallMethod:
db 1
ConvertRoutine:
[64-bit]
mov eax,[rcx]
btr eax,1F
xor eax,[rcx+08]
[/64-bit]
ret

ConvertBackRoutine:
[64-bit]
mov eax,[r8]
btr eax,1F
xor ecx,eax
mov [r8+08],ecx
[/64-bit]
ret
]])
end

if not getCustomType("X4 - 8 Bytes") then
registerCustomTypeAutoAssembler([[
alloc(ConvertRoutine,1024)
alloc(ConvertBackRoutine,1024)
alloc(TypeName,256)
alloc(ByteSize,8)
alloc(UsesFloat,1)
alloc(UsesString,1)
alloc(MaxStringSize,2)
alloc(CallMethod,1)
TypeName:
db 'X4 - 8 Bytes',0
ByteSize:
dd 8
UsesFloat:
db 0
UsesString:
db 0
MaxStringSize:
dw #100
CallMethod:
db 1

ConvertRoutine:
[64-bit]
mov rax,[rcx]
sub rdx,10
xor rax,rdx
xor rax,7FFFFFFF
[/64-bit]
ret

ConvertBackRoutine:
[64-bit]
sub rdx,10
xor rcx,rdx
xor rcx,7FFFFFFF
mov [r8],rcx
[/64-bit]
ret
]])
end

{$asm}
[DISABLE]
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>24</ID>
          <Description>"Player Credits"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript Async="1">[ENABLE]
aobscanmodule(credits,$process,48 85 C0 48 0F 45 C8 48 8B 01 FF 50 ?? 48 8B ?? 0F 57)
alloc(newmem,$1000,credits)

label(creditsPtr)
label(creditsBkp)
label(return)

newmem:
creditsBkp:
  readmem(credits,7)
  mov rax,creditsPtr
  mov [rax],rcx
  jmp return

align 10
creditsPtr:
  dq 0

credits:
  jmp newmem
  nop 2
return:
registersymbol(credits)
registersymbol(creditsBkp)
registersymbol(creditsPtr)

[DISABLE]
credits:
  db 48 85 C0 48 0F 45 C8
unregistersymbol(credits)
unregistersymbol(creditsBkp)
unregistersymbol(creditsPtr)
dealloc(newmem)

