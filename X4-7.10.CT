// inc dword ptr [pAmmoOwner]
//
// mov eax,[rdx+28]                  // Original code
// mov r8d,00000001                  // Original code
// jmp _BackMSM                      // Back to main code

//========================================= 4.20 New (changed)
// All the time
// RAX is safe
_MonShipShield2:
 mov dword ptr [aLast],'_SS2'

 cmp dword ptr [iEnableMSS],0
 je _ExitSS2                       // Jump if feature is disabled

 mov rcx,[rbx+00000200]
 test rcx,rcx
 jz _ExitSS2

 mov rax,[rcx+00000090]
 test rax,rax
 jnz _ExitSS2

{$try}
 mov rax,[rbx+000002D0]
 jmp short noerror

{$except}
 mov eax,55555555

noerror:
 mov [rcx+000000A0],rax

 cmp rax,[pCommon]
 jne _ExitSS2

 mov eax,[rcx+34]
 mov [rcx+58],eax

_ExitSS2:
 mov rcx,[rbx+00000200]            // Original code
 jmp _BackSS2                      // Back to main code

//========================================= 4.20 New
// When decreasing Missiles
//_MonShipMissiles2:
// mov dword ptr [aLast],'_SM2'
//
// mov [pAmmoOwner],rdi
//
//_ExitSM2:
// mov rcx,[r14+00000260]            // Original code
// jmp _BackSM2                      // Back to main code

