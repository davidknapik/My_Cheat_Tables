  <CheatEntries>
    <CheatEntry>
      <ID>611</ID>
      <Description>"Credits never go down"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : X4.exe
  Version:
  Date   : 2023-02-17
  Author : JC

  Do an unkown value search, find out what writes to the found address, HACK it.
}

[ENABLE]

aobscanmodule(INJECT_CREDIT,X4.exe,48 2B D0 48 33 D3) // should be unique


INJECT_CREDIT:
  db 90 90 90 48 33 D3

registersymbol(INJECT_CREDIT)


[DISABLE]

INJECT_CREDIT:
  db 48 2B D0 48 33 D3

unregistersymbol(INJECT_CREDIT)


{
// ORIGINAL CODE - INJECT_CREDITION POINT: X4.exe+86882D

X4.exe+86880E - CC                    - int 3
X4.exe+86880F - CC                    - int 3
X4.exe+868810 - 40 53                 - push rbx
X4.exe+868812 - 48 83 EC 20           - sub rsp,20
X4.exe+868816 - 48 8B 01              - mov rax,[rcx]
X4.exe+868819 - 48 8B D9              - mov rbx,rcx
X4.exe+86881C - FF 50 40              - call qword ptr [rax+40]
X4.exe+86881F - 48 8B D3              - mov rdx,rbx
X4.exe+868822 - 48 33 53 10           - xor rdx,[rbx+10]
X4.exe+868826 - 48 81 F2 FFFFFF7F     - xor rdx,7FFFFFFF
// ---------- INJECT_CREDITING HERE ----------
X4.exe+86882D - 48 2B D0              - sub rdx,rax
// ---------- DONE INJECT_CREDITING  ----------
X4.exe+868830 - 48 33 D3              - xor rdx,rbx
X4.exe+868833 - 48 81 F2 FFFFFF7F     - xor rdx,7FFFFFFF
X4.exe+86883A - 48 89 53 10           - mov [rbx+10],rdx
X4.exe+86883E - 48 83 C4 20           - add rsp,20
X4.exe+868842 - 5B                    - pop rbx
X4.exe+868843 - C3                    - ret
X4.exe+868844 - CC                    - int 3
X4.exe+868845 - CC                    - int 3
X4.exe+868846 - CC                    - int 3
}
</AssemblerScript>
    </CheatEntry>
