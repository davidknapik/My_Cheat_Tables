//AOBScanModule(MOPS,$process,FF 90 18 13 00 00 48 83 7B 50 02 4C 8D 43 40 4C 8B D0 74 ?? 4D 8B 48 18) //.
AOBScanModule(GDMD,$process,F3 0F 11 8F F4 01 00 00 F3 41) //.
//AOBScanModule(GDMD,$process,F3 0F 11 8F F4 01 00 00 F3 41 0F 5C F2 0F 54 F7 FF 90 E8 18 00 00) //.
AOBScanModule(MOSS,$process,8b 02 f2 0f 11 51 f0 89 41 e8 c3)
