    <CheatEntry>
      <ID>617</ID>
      <Description>"Player faction"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : X4.exe
  Version: 
  Date   : 2024-06-23
  Author : eidng8

  Find out pointer to any of owned ship by whatever mean, then find the owner
  faction pointer in the ship's data.
  Or maybe easier, shorten the AOB bytes and try if you can get a match.
  The "pPlayer" variable is used by other scripts.
}

[ENABLE]

aobscanmodule(INJECT_PLAYER_INFO,X4.exe,C6 44 24 60 01 48 85 C0 74 08 8B B8 C8 01 00 00 EB 02 33 FF 48 8B 01 FF 90 ?? ?? ?? ?? 4C 8D 4C 24 60 48 89 6C 24 20 0F AF C7 48 8D 4C 24 30 48 8B D6 44 8D 40 01) // should be unique
alloc(newmem,$1000,INJECT_PLAYER_INFO)

label(code)
label(return)
label(skip)
label(pPlayerInfoInject)
label(pPlayer)

newmem:

code:
  mov edi,[rax+08]
  cmp edi,'play'
  jne skip
  mov [pPlayer],rax

skip:
  mov edi,[rax+01C8]    // Original code
  jmp return


align 10, '='
pPlayer:
  dq 0


//=========================================
// Hacking Points
INJECT_PLAYER_INFO+0a:
pPlayerInfoInject:
  jmp newmem
  nop
return:


registersymbol(INJECT_PLAYER_INFO)
registersymbol(pPlayerInfoInject)
registersymbol(pPlayer)


[DISABLE]

INJECT_PLAYER_INFO+0a:
pPlayerInfoInject:
  db 8B B8 C8 01 00 00

unregistersymbol(INJECT_PLAYER_INFO)
unregistersymbol(pPlayerInfoInject)
unregistersymbol(pPlayer)

dealloc(newmem)

{
// INJECT_PLAYER_INFO
// ORIGINAL CODE - INJECTION POINT: X4.exe+7B2BED

X4.exe+7B2BC5: 48 89 6C 24 20        - mov [rsp+20],rbp
X4.exe+7B2BCA: 56                    - push rsi
X4.exe+7B2BCB: 48 83 EC 50           - sub rsp,50
X4.exe+7B2BCF: 48 8B B1 B8 00 00 00  - mov rsi,[rcx+000000B8]
X4.exe+7B2BD6: 49 8B E8              - mov rbp,r8
X4.exe+7B2BD9: 48 8B DA              - mov rbx,rdx
X4.exe+7B2BDC: 48 85 F6              - test rsi,rsi
X4.exe+7B2BDF: 74 4E                 - je X4.exe+7B2C2F
X4.exe+7B2BE1: 48 8B 05 48 F1 51 02  - mov rax,[X4.exe+2CD1D30]
X4.exe+7B2BE8: 48 89 7C 24 68        - mov [rsp+68],rdi
// ---------- INJECTING HERE ----------
X4.exe+7B2BED: C6 44 24 60 01        - mov byte ptr [rsp+60],01
// ---------- DONE INJECTING  ----------
X4.exe+7B2BF2: 48 85 C0              - test rax,rax
X4.exe+7B2BF5: 74 08                 - je X4.exe+7B2BFF
X4.exe+7B2BF7: 8B B8 C8 01 00 00     - mov edi,[rax+000001C8]
X4.exe+7B2BFD: EB 02                 - jmp X4.exe+7B2C01
X4.exe+7B2BFF: 33 FF                 - xor edi,edi
X4.exe+7B2C01: 48 8B 01              - mov rax,[rcx]
X4.exe+7B2C04: FF 90 C0 12 00 00     - call qword ptr [rax+000012C0]
X4.exe+7B2C0A: 4C 8D 4C 24 60        - lea r9,[rsp+60]
X4.exe+7B2C0F: 48 89 6C 24 20        - mov [rsp+20],rbp
X4.exe+7B2C14: 0F AF C7              - imul eax,edi
}
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>628</ID>
          <Description>"lock hull"</Description>
          <Options moHideChildren="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : X4.exe
  Version: 
  Date   : 2024-06-26
  Author : jacke

  Find a pointer to any of owned ship by whatever means. Find the hull value in
  ship's data, find out what writes to that memory, then HACK it.
}

[ENABLE]

aobscanmodule(INJECT_SHIP_HULL,X4.exe,F3 44 0F 5C E1 F3 0F) // should be unique
alloc(newmem,$1000,INJECT_SHIP_HULL)

label(code)
label(return)
label(lock)
label(done)
label(original)

newmem:

code:
  push rcx
  push rdx
  mov rcx, [pPlayer]
  // for ships, rdi points to ship
  cmp rcx, [rdi+368]
  je lock
{$try}
  // for surface elements
  // rbx -&gt; component, component+68 -&gt; ship, ship+368 -&gt; player faction
  mov rdx, [rbx+68]
  cmp rcx, [rdx+368]
  jne original
  movss [rbx+0000028C], xmm0         // xmm0 has max hull
  jmp done
{$except}
  nop
  jne original

lock:
{$try}
  movss [rdi+0000028C], xmm0         // xmm0 has max hull
  jmp done
{$except}
  nop

original:
  subss xmm12, xmm1                 // ORIGINAL CODE
  movss [rdi+0000028C], xmm1        // ORIGINAL CODE

done:
  pop rdx
  pop rcx
  jmp return

INJECT_SHIP_HULL:
  jmp newmem
  nop 8
return:


registersymbol(INJECT_SHIP_HULL)

[DISABLE]

INJECT_SHIP_HULL:
  db F3 44 0F 5C E1 F3 0F 11 8F 8C 02 00 00


unregistersymbol(INJECT_SHIP_HULL)
dealloc(newmem)

{
// ORIGINAL CODE - INJECTION POINT: X4.exe+4FEC33

X4.exe+4FEC01: 48 8D 8C 24 D0 00 00 00     - lea rcx,[rsp+000000D0]
X4.exe+4FEC09: 45 0F 28 E2                 - movaps xmm12,xmm10
X4.exe+4FEC0D: 41 0F 28 F1                 - movaps xmm6,xmm9
X4.exe+4FEC11: 0F 2F C8                    - comiss xmm1,xmm0
X4.exe+4FEC14: F3 0F 11 8C 24 D8 00 00 00  - movss [rsp+000000D8],xmm1
X4.exe+4FEC1D: 48 0F 46 C8                 - cmovbe rcx,rax
X4.exe+4FEC21: 48 8B 07                    - mov rax,[rdi]
X4.exe+4FEC24: F3 0F 10 09                 - movss xmm1,[rcx]
X4.exe+4FEC28: 48 8B CF                    - mov rcx,rdi
X4.exe+4FEC2B: F3 0F 5F 8F 88 02 00 00     - maxss xmm1,[rdi+00000288]
// ---------- INJECTING HERE ----------
X4.exe+4FEC33: F3 44 0F 5C E1              - subss xmm12,xmm1
// ---------- DONE INJECTING  ----------
X4.exe+4FEC38: F3 0F 11 8F 8C 02 00 00     - movss [rdi+0000028C],xmm1
X4.exe+4FEC40: F3 41 0F 5C F4              - subss xmm6,xmm12
X4.exe+4FEC45: 0F 54 F7                    - andps xmm6,xmm7
X4.exe+4FEC48: FF 90 28 1B 00 00           - call qword ptr [rax+00001B28]
X4.exe+4FEC4E: F3 0F 59 05 26 65 BA 01     - mulss xmm0,[X4.exe+20A517C]
X4.exe+4FEC56: 0F 2F F0                    - comiss xmm6,xmm0
X4.exe+4FEC59: 73 04                       - jae X4.exe+4FEC5F
X4.exe+4FEC5B: 45 0F 28 E1                 - movaps xmm12,xmm9
X4.exe+4FEC5F: 41 0F 28 C4                 - movaps xmm0,xmm12
X4.exe+4FEC63: 0F 54 C7                    - andps xmm0,xmm7
}
</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>636</ID>
              <Description>"lock shield"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : X4.exe
  Version: 
  Date   : 2024-06-28
  Author : jacke

  Find a pointer to any of owned ship by whatever means. Find the pointer to
  shield in ship's data, find out what writes to that memory, then HACK it.
}

[ENABLE]

aobscanmodule(INJECT_SHIELD_SUBTRACT,X4.exe, 8b 02 f2 0f 11 51 f0 89 41 e8 c3) // should be unique
alloc(newmem,$1000,INJECT_SHIELD_SUBTRACT)

label(code)
label(return)
label(done)

newmem:
  push rcx
  push rbx
  mov rcx, [pPlayer]
{$try}
  // for ships, rdi points to ship
  cmp rcx, [rdi+368]
  je done
  // for surface elements
  // rsi -&gt; component, component+68 -&gt; ship, ship+368 -&gt; player faction
  mov rbx, [rsi+68]
  cmp rcx, [rbx+368]
  je done
  jmp code
{$except}
  nop

code:
  pop rbx
  pop rcx
  mov eax,[rdx]                          // original code
  movsd [rcx-10],xmm2                    // original code
  mov [rcx-18],eax                       // original code
  jmp return

done:
  pop rbx
  pop rcx
  jmp return

INJECT_SHIELD_SUBTRACT:
  jmp newmem
  nop 5
return:
registersymbol(INJECT_SHIELD_SUBTRACT)

[DISABLE]

INJECT_SHIELD_SUBTRACT:
  db 8b 02 f2 0f 11 51 f0 89 41 e8 c3

unregistersymbol(INJECT_SHIELD_SUBTRACT)
dealloc(newmem)

{
// ORIGINAL CODE - INJECTION POINT: X4.exe+44E610

X4.exe+44E606: CC              - int 3 
X4.exe+44E607: CC              - int 3 
X4.exe+44E608: CC              - int 3 
X4.exe+44E609: CC              - int 3 
X4.exe+44E60A: CC              - int 3 
X4.exe+44E60B: CC              - int 3 
X4.exe+44E60C: CC              - int 3 
X4.exe+44E60D: CC              - int 3 
X4.exe+44E60E: CC              - int 3 
X4.exe+44E60F: CC              - int 3 
// ---------- INJECTING HERE ----------
X4.exe+44E610: 8B 02           - mov eax,[rdx]
// ---------- DONE INJECTING  ----------
X4.exe+44E612: F2 0F 11 51 F0  - movsd [rcx-10],xmm2
X4.exe+44E617: 89 41 E8        - mov [rcx-18],eax
X4.exe+44E61A: C3              - ret 
X4.exe+44E61B: CC              - int 3 
X4.exe+44E61C: CC              - int 3 
X4.exe+44E61D: CC              - int 3 
X4.exe+44E61E: CC              - int 3 
X4.exe+44E61F: CC              - int 3 
X4.exe+44E620: F2 0F 10 41 F0  - movsd xmm0,[rcx-10]
X4.exe+44E625: C3              - ret 
}
</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
