 db '===============================&gt;'
 db 'CE7.4 Script by Recifense 220407'
//=========================================
// Variables
iEnableMPM:
 dq 0
iEnableGMD:
 dq 0
iEnableMSS:
 dq 0
iEnableMSM:
 dq 0
lMinMon:
 dq #73000000000
pMoney:
 dq 0
pPlayer:
 dq 0
pShip:
 dq MyCode
pShield:
 dq MyCode
pCommon:
 dq MyCode
pRSI:
 dq 0
pRDI:
 dq 0
pRBX:
 dq 0
pRCX:
 dq 0
pAmmoOwner:
 dq MyCode
iCount:
 dq 0
aLast:
 dd 'CE74'

