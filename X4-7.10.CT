    <CheatEntry>
      <ID>614</ID>
      <Description>"Pause the game, then eanble this; DISABLE it before resuming!"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>23</ID>
          <Description>"Item qty never go down"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : X4.exe
  Version:
  Date   : 2023-03-23
  Author : JC

  *** REMEMBER TO COMPLETE EACH TRADE EVERY TIME ***
  1. Go to a trader;
  2. Buy one item first it your personal inventory is empty, more than 1 qty;
  3. Start a scan using Unkonw initial value;
  4. Sell the item, DON'T sell out, leave at leest one qty in inventory;
  5. Scan for Changed value;
  6. Buy the item back;
  7. Repeat setp 4~6;
  8. Scan for Unchanged value from time to time between trades;
  9. You can also scan for Unchanged value with "Compare to first scan" checked.
  10. Find out what writes to the found address;
  11. Hack it!
}

[ENABLE]

aobscanmodule(CHG_INV_QTY,$process, 41 03 CB 74 11) // should be unique
alloc(HACK_CHG_INV_QTY, $20, CHG_INV_QTY)

label(code)
label(return)
label(_go_on)


HACK_CHG_INV_QTY:

code:
  cmp r11d,0
  jl _go_on
  add ecx,r11d   // original code
_go_on:
  je X4.exe+7F4A94  // original code
  jmp return

CHG_INV_QTY:
  jmp HACK_CHG_INV_QTY
return:


registersymbol(CHG_INV_QTY)



[DISABLE]

CHG_INV_QTY:
  db 41 03 CB 74 11


unregistersymbol(CHG_INV_QTY)
dealloc(HACK_CHG_INV_QTY)


{
// ORIGINAL CODE - INJECTION POINT: X4.exe+7E77EE

X4.exe+7E77CC: 48 8D 54 24 38  - lea rdx,[rsp+38]
X4.exe+7E77D1: E8 7A 5B 05 00  - call X4.exe+845490
X4.exe+7E77D6: 48 8B 7C 24 30  - mov rdi,[rsp+30]
X4.exe+7E77DB: 48 83 C4 20     - add rsp,20
X4.exe+7E77DF: 5B              - pop rbx
X4.exe+7E77E0: C3              - ret
X4.exe+7E77E1: 41 8B 00        - mov eax,[r8]
X4.exe+7E77E4: 0F BA F0 1F     - btr eax,1F
X4.exe+7E77E8: 8B C8           - mov ecx,eax
X4.exe+7E77EA: 41 33 48 08     - xor ecx,[r8+08]
// ---------- INJECTING HERE ----------
X4.exe+7E77EE: 41 03 CB        - add ecx,r11d
// ---------- DONE INJECTING  ----------
X4.exe+7E77F1: 74 11           - je X4.exe+7EF8A4
X4.exe+7E77F3: 48 8B 7C 24 30  - mov rdi,[rsp+30]
X4.exe+7E77F8: 33 C1           - xor eax,ecx
X4.exe+7E77FA: 41 89 40 08     - mov [r8+08],eax
X4.exe+7E77FE: 48 83 C4 20     - add rsp,20
X4.exe+7E7802: 5B              - pop rbx
X4.exe+7E7803: C3              - ret
X4.exe+7E7804: 4D 8D 48 10     - lea r9,[r8+10]
X4.exe+7E7808: 48 8B CB        - mov rcx,rbx
X4.exe+7E780B: 48 8D 54 24 38  - lea rdx,[rsp+38]
}
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>21</ID>
          <Description>"Find ship MOD values (PATIENCE!!)"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : X4.exe
  Version:
  Date   : 2023-03-22
  Author : JC

  There are 4 entry points can be jumped to directly:
        * X4.InstallShipMod
        * X4.InstallGroupedWeaponMod
        * X4.InstallShieldMod
        * X4.InstallEngineMod
  (Just call these functions FN for the sake of simplicity)

  Look for the last error message, usually reads like:
       "InstallEngineMod(): Failed to retrieve ware information for war"

  The call to calculation is not far from the last error message. Which should
  be something similar to these:
     call X4.exe+NNNNNN // &lt;-- FC
     mov rXX,rax
     test rax,rax
     je FN+xxx  // &lt;-- exiting the function

  The call leads to the calculation entry point (FC for short). Near the start
  of FC, look for something similar to these:
     call X4.exe+NNNNNN // &lt;-- FD
     xorps xmm0,xmm0
     comiss xmm0,[rXX+NN]

  The call leads to actual calculation routine (FD for short). It can be (seems)
  recognized by the line "mov rXX,gx:[NNNN]" right after initiation section.
  Scroll down a little until the line "jmp rXX". The actual calculation starts
  from here. A piece of sample code in attached at the bottom of this script.

  All calculations have their dedicated code block, though all such blocks are
  the same, except engine mods.

  The FD routine for shield mods is different, it doesn't use "jmp rXX", all
  calculation blocks are placed inside the routine.

  If for whatever reason FN cannot be located, one use the "Item qty never go
  down" script to find the item subtraction code, set a break point there, and
  find out what's calling it when mod is applied.

  These code blocks are next to each other, with each block 0x74 bytes in size.

  // ORIGINAL CODE 1
  X4.exe+7F0558 - F3 0F5C CB            - subss xmm1,xmm3
  X4.exe+7F055C - F3 0F59 CA            - mulss xmm1,xmm2
  X4.exe+7F0560 - F3 0F58 CB            - addss xmm1,xmm3

  // ORIGINAL CODE 2
  0:  f3 0f 5c d3             subss  xmm2,xmm3
  4:  f3 0f 59 d1             mulss  xmm2,xmm1
  8:  f3 0f 58 d3             addss  xmm2,xmm3
}


{$lua}
if syntaxcheck then return end



[ENABLE]
scan1 = AOBScan("F3 0F 5C ?? F3 0F 59 ?? F3 0F 58 ??", "+X-C-W")
rcMod1 = scan1.Count
registerSymbol("rcMod1", rcMod1)
--[[
scan2 = AOBScan("F3 0F 5C F7 F3 0F 59 F2 F3 0F 58 F7")
rcMod2 = scan2.Count
registerSymbol("rcMod2", rcMod2)
--]]
function defSymbols(t)
  for i=1, rcMod1, 1 do
    registerSymbol("rvMod1_"..tostring(i),scan1[i-1])
  end
  --[[
  for i=1, rcMod2, 1 do
    registerSymbol("rvMod2_"..tostring(i),scan2[i-1])
  end
  --]]

  scan1.destroy()
  -- scan2.destroy()
  t.destroy()
end

local timer=createTimer()
timer.Interval=1
timer.OnTimer=defSymbols



[DISABLE]
for i=1, rcMod1, 1 do
  unregisterSymbol("rvMod1_"..tostring(i))
end
--[[
for i=1, rcMod2, 1 do
  unregisterSymbol("rvMod2_"..tostring(i))
end
--]]

rcMod1=nul
-- rcMod2=nul
unregisterSymbol("rcMod1")
-- unregisterSymbol("rcMod2")

</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>615</ID>
              <Description>"Lock ship MOD values to max"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]
for i=1, rcMod1, 1 do
  writeBytes("rvMod1_"..tostring(i),0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90)
end
--[[
for i=1, rcMod2, 1 do
  writeBytes("rvMod2_"..tostring(i),0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90)
end
--]]


[DISABLE]
for i=1, rcMod1, 1 do
  writeBytes("rvMod1_"..tostring(i),0xF3,0x0F,0x5C,0xCB,0xF3,0x0F,0x59,0xCA,0xF3,0x0F,0x58,0xCB)
end
--[[
for i=1, rcMod2, 1 do
  writeBytes("rvMod2_"..tostring(i),0xF3,0x0F,0x5C,0xD3,0xF3,0x0F,0x59,0xD1,0xF3,0x0F,0x58,0xD3)
end
--]]
</AssemblerScript>
