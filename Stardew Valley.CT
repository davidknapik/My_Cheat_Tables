  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"*InfItems"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>// MS.NET
// Image: Stardew Valley.dll
// Class: stardewvalley.item
// Method: ConsumeStack(object amount)
// Item Qty: 4 byte
// Requires right click to pick up all of a single item in inventory to load method
[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
//aobscanmodule(aob_infitems, "Stardew Valley.exe", 48 8B CE FF 53 08 8B D0 2B D7 48 8B CE FF 53 10)
aobscan(aob_infitems, 48 8B CE FF 53 08 8B D0 2B D7 48 8B CE FF 53 10 48 8B C6)
registersymbol(aob_infitems)

aob_infitems+8:
db 90 90



/*
StardewValley.Item::ConsumeStack+35 - 5E                    - pop rsi
StardewValley.Item::ConsumeStack+36 - 5F                    - pop rdi
StardewValley.Item::ConsumeStack+37 - C3                    - ret
StardewValley.Item::ConsumeStack+38 - 48 8B CE              - mov rcx,rsi
StardewValley.Item::ConsumeStack+3B - FF 53 08              - call qword ptr [rbx+08]
StardewValley.Item::ConsumeStack+3E - 8B D0                 - mov edx,eax
StardewValley.Item::ConsumeStack+40 - 2B D7                 - sub edx,edi   &lt;&lt;&lt;&lt;&lt;
StardewValley.Item::ConsumeStack+42 - 48 8B CE              - mov rcx,rsi
StardewValley.Item::ConsumeStack+45 - FF 53 10              - call qword ptr [rbx+10]
StardewValley.Item::ConsumeStack+48 - 48 8B C6              - mov rax,rsi
StardewValley.Item::ConsumeStack+4B - 48 83 C4 20           - add rsp,20 { 32 }
StardewValley.Item::ConsumeStack+4F - 5B                    - pop rbx
StardewValley.Item::ConsumeStack+50 - 5E                    - pop rsi
StardewValley.Item::ConsumeStack+51 - 5F                    - pop rdi
*/
 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
aob_infitems+8:
db 2B D7
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>2</ID>
