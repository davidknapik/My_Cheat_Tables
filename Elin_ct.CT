                  <CheatEntries>
                    <CheatEntry>
                      <ID>26441</ID>
                      <Description>"P-&gt;Chara"</Description>
                      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
                      <ShowAsSigned>0</ShowAsSigned>
                      <Color>008080</Color>
                      <GroupHeader>1</GroupHeader>
                      <Address/>
                      <CheatEntries>
                        <CheatEntry>
                          <ID>12814</ID>
                          <Description>"Owned Thing Data"</Description>
                          <Options moHideChildren="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
                          <Color>D09000</Color>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>{$lua}
if syntaxcheck then return end

local list = AddressList["Dropdown.Things"]
local chara = Recorder.getChild(AddressList["Highlighted Character Data Modifier"], "P-&gt;Chara")
local things = Recorder.getChild(chara, "P-&gt;things")
local parent = Recorder.getChild(things, "P-&gt;_items")

local function getLanguageOffset(memrec)
    if (memrec.value == "JP") then return 0x38 end
    if (memrec.value == "EN") then return 0x30 end
    if not ((memrec.value == "JP") and (memrec.value == "EN")) then return 0x260 end
end

list.DropdownList.clear()

[ENABLE]

local base = Recorder.getAddress(parent, true) or error(messageDialog("Nothing.", 2, 2))
local size = Recorder.getChild(things, "_size")
local offs = getLanguageOffset(Recorder.getChild(AddressList["P-&gt;CoreConfig"], "lang"))

for i = 0, tonumber(size.value) - 1 do
    local thing = readPointer(base + i * 0x08 + 0x20)
    local row   = readPointer(thing + 0xE8)
    if not row then goto continue end
    local name  = readString(readPointer(row + offs) + 0x14, 6000, true)
    list.DropdownList.add(("%X:%s"):format(thing, name))
    ::continue::
end

local ptr = assert(Recorder.showDropdown(list), "Interrupted")

Recorder.addressUpdate(memrec, memrec[0], ptr)

[DISABLE]
</AssemblerScript>
                          <CheatEntries>
                            <CheatEntry>
                              <ID>12815</ID>
                              <Description>"Thing"</Description>
                              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
                              <ShowAsSigned>0</ShowAsSigned>
                              <Color>008080</Color>
                              <GroupHeader>1</GroupHeader>
                              <Address/>
                              <CheatEntries>
                                <CheatEntry>
                                  <ID>18776</ID>
                                  <Description>"Element Data"</Description>
                                  <Options moHideChildren="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
                                  <Color>D09000</Color>
                                  <VariableType>Auto Assembler Script</VariableType>
                                  <AssemblerScript>{$lua}
if syntaxcheck then return end

local list   = AddressList["Dropdown.GrantedElements"]
local dict   = Recorder.getChild(AddressList["P-&gt;Thing.elements"], "P-&gt;dict")
local parent = Recorder.getChild(dict, "P-&gt;_entries")

local function getLanguageOffset(memrec)
    if (memrec.value == "JP") then return 0x20 end
    if (memrec.value == "EN") then return 0x28 end
    if not ((memrec.value == "JP") and (memrec.value == "EN")) then return 0x158 end
end

list.DropdownList.clear()

[ENABLE]

local base = Recorder.getAddress(parent, true) or error(messageDialog("Nothing.", 2, 2))
local size = Recorder.getChild(dict, "_count")
local offs = getLanguageOffset(Recorder.getChild(AddressList["P-&gt;CoreConfig"], "lang"))

for i = 0, tonumber(size.value) - 1 do
    local main = readPointer(base + i * 0x18 + 0x30)
    local row  = readPointer(main + 0x10)
    if not row then goto continue end
    local name = readString(readPointer(row + offs) + 0x14, 6000, true) or "??"
    local new  = string.gsub(name, "\n", "-&gt;")
    local grp = readString(readPointer(row + 0x70) + 0x14, 6000, true) or "??"
    list.DropdownList.add(("%X:%s (%s)"):format(main, new, grp))
    ::continue::
end

local ptr      = assert(Recorder.showDropdown(list), "Interrupted")
local id, name = mono_object_getClass(getAddress(ptr))

memrec[0].description = name

Recorder.addressUpdate(memrec, memrec[0], ptr)

[DISABLE]
</AssemblerScript>
