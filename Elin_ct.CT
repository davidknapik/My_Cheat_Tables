                  <Color>808080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

local req = AddressList["Required.CreateDropdown.Races"]

[ENABLE]

req.active = true

local met = mono_findMethod('', 'CoreDebug', 'ChangeRace')
local ins = Recorder.getAddress(AddressList['P-&gt;CoreDebug'])
local sId = Recorder.showDropdown(AddressList["Dropdown.Races"])

if not sId or (sId == "??") then req.active = false; assert(req.active, "Interrupted") end

local args = {
    {type = vtString, value = sId}
}

req.active = false

local msg = mono_invoke_method('', met, ins, args)

messageDialog(msg, 2, 2); assert(memrec.active, "Executed")

[DISABLE]
</AssemblerScript>
