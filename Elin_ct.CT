[ENABLE]

registerlabel(p_dmg_times)

mem0x04:
  readmem(Card_DamageHP,15)
  mov rdi,[rbp+38] // Card:DamageHP+37
  mov r13,[rdi+178] // strs
  test r13,r13
  je @f
  mov r13,[r13+30] // faction
  test r13,r13
  je @f
  mov r11,0065006D006F0068 // home
  cmp qword ptr [r13+14],r11
  jne @f
  cvtsi2ss xmm0,edx
  mulss xmm0,[p_dmg_times]
  cvtss2si edx,xmm0
@@:
  jmp return
  align 10 CC

p_dmg_times:
  dd (float)10.0

Card_DamageHP:
  jmp far mem0x04
  nop
return:

