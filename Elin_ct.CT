                <CheatEntry>
                  <ID>27935</ID>
                  <Description>"Reserved.RemoveElement"</Description>
                  <Color>808080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

local list   = AddressList["Dropdown.Elements"]
local dict   = Recorder.getChild(AddressList["P-&gt;Chara.elements"], "P-&gt;dict")
local parent = Recorder.getChild(dict, "P-&gt;_entries")

local function getLanguageOffset(memrec) return (memrec.value == "EN") and 0x28 or 0x20 end

list.DropdownList.clear()

[ENABLE]

local base = Recorder.getAddress(parent, true) or error(messageDialog("Nothing.", 2, 2))
local size = Recorder.getChild(dict, "_count")
local offs = getLanguageOffset(Recorder.getChild(AddressList["P-&gt;CoreConfig"], "lang"))

for i = 0, tonumber(size.value) - 1 do
    local main = readPointer(base + i * 0x18 + 0x30)
    local row  = readPointer(main + 0x10)
    if not row then goto continue end
    local name = readString(readPointer(row + offs) + 0x14, 6000, true) or "??"
    local new  = string.gsub(name, "\n", "-&gt;")
    local id   = readInteger(row + 0x198)
    local typ  = readString(readPointer(row + 0x68) + 0x14, 6000, true) or "??"
    list.DropdownList.add(("%s:%s (%s)"):format(id, new, typ))
    ::continue::
end

local met = mono_findMethodBySignature("Elin", "ElementContainer", "Remove", "int")

mono_compile_method(met)

local ins = Recorder.getAddress(AddressList["P-&gt;Chara.elements"])
local str = assert(Recorder.showDropdown(AddressList["Dropdown.Elements"]), "Interrupted")

mono_invoke_method('', met, ins, {{type = vtDword, value = tonumber(str)}})
beep(); assert(memrec.active, "Executed")

[DISABLE]
</AssemblerScript>
                </CheatEntry>
