                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$lua}
if syntaxcheck then return end

local list   = AddressList["Dropdown.Charas"]
local source = Recorder.getChild(AddressList["P-&gt;SourceChara"], "P-&gt;rows")
local parent = Recorder.getChild(source, "P-&gt;_items")

local function getLanguageOffset(memrec)
    if (memrec.value == "JP") then return 0x38 end
    if (memrec.value == "EN") then return 0x30 end
    if not ((memrec.value == "JP") and (memrec.value == "EN")) then return 0x290 end
end

list.DropdownList.clear()

[ENABLE]

local base = Recorder.getAddress(parent)
local size = Recorder.getChild(source, "_size")
local offs = getLanguageOffset(Recorder.getChild(AddressList["P-&gt;CoreConfig"], "lang"))

for i = 0, tonumber(size.value) - 1 do
    local ptr = readPointer(base + i * 0x08 + 0x20)
    local name = readString(readPointer(ptr + offs) + 0x14, 6000, true) or "??"
    local id = readString(readPointer(ptr + 0x120) + 0x14, 6000, true)
    list.DropdownList.add(("%s:%s"):format(id, name))
end

list.DisplayAsDropDownListItem = true

