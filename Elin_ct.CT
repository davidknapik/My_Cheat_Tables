                <CheatEntry>
                  <ID>40600</ID>
                  <Description>"Spawn Character"</Description>
                  <Color>808080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

local dbg  = AddressList["Toggle Debug Mode"]
local req1 = AddressList["Required.CreateDropdown.Charas"]
local req2 = AddressList["Required.CreateDropdown.Materials"]
local thi  = AddressList["Dropdown.Charas"]
local spt  = AddressList["Required.getSpawnArgs"]

[ENABLE]

local undo = dbg.active

dbg.active, req1.active = true, true

local met = mono_findMethod('', 'CoreDebug', 'Spawn')
local ins = Recorder.getAddress(AddressList['P-&gt;CoreDebug'])
local tId = Recorder.showDropdown(thi)
local lvl = inputQuery(memrec.description, 'Generate Lv:', '-1')

assert(tId and lvl, "Interrupted")
Recorder.writeValue(spt[0], "-1"); Recorder.writeValue(spt[1], lvl)

local args = {
    {type = vtString, value = tId},
    {type = vtDword,  value = 1},
    {type = vtString, value = ""}
}

req1.active = false

local msg = mono_invoke_method('', met, ins, args)

dbg.active = undo

messageDialog(msg, 2, 2); assert(memrec.active, "Executed")

[DISABLE]
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>30430</ID>
                  <Description>"Current Zone Data Modifier"</Description>
                  <Options moHideChildren="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
                  <Color>808080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

local req = AddressList["Required.CreateDropdown.Elements"]

[ENABLE]

local ptr = Recorder.getAddress(AddressList["P-&gt;activeZone"], true)

assert(ptr, "No reference")

Recorder.addressUpdate(memrec, memrec[0], ptr)

req.active = true

[DISABLE]

req.active = false
</AssemblerScript>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>30431</ID>
                      <Description>"Zone"</Description>
                      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
                      <Color>008080</Color>
                      <GroupHeader>1</GroupHeader>
                      <Address/>
                      <CheatEntries>
                        <CheatEntry>
                          <ID>29982</ID>
                          <Description>"Element Data"</Description>
                          <Options moHideChildren="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
                          <Color>D09000</Color>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>{$lua}
if syntaxcheck then return end

local list   = AddressList["Dropdown.GrantedElements"]
local dict   = Recorder.getChild(AddressList["P-&gt;Zone.elements"], "P-&gt;dict")
local parent = Recorder.getChild(dict, "P-&gt;_entries")

local function getLanguageOffset(memrec) return (memrec.value == "EN") and 0x28 or 0x20 end

list.DropdownList.clear()

[ENABLE]

local base = Recorder.getAddress(parent, true) or error(messageDialog("Nothing.", 2, 2))
local size = Recorder.getChild(dict, "_count")
local offs = getLanguageOffset(Recorder.getChild(AddressList["P-&gt;CoreConfig"], "lang"))

for i = 0, tonumber(size.value) - 1 do
    local main = readPointer(base + i * 0x18 + 0x30)
    local row  = readPointer(main + 0x10)
    if not row then goto continue end
    local name = readString(readPointer(row + offs) + 0x14, 6000, true) or "??"
    local new  = string.gsub(name, "\n", "-&gt;")
    local grp = readString(readPointer(row + 0x70) + 0x14, 6000, true) or "??"
    list.DropdownList.add(("%X:%s (%s)"):format(main, new, grp))
    ::continue::
end

local ptr      = assert(Recorder.showDropdown(list), "Interrupted")
local id, name = mono_object_getClass(getAddress(ptr))

memrec[0].description = name

Recorder.addressUpdate(memrec, memrec[0], ptr)

