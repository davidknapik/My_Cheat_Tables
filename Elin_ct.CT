                        <CheatEntry>
                          <ID>27748</ID>
                          <Description>"Give Element"</Description>
                          <Color>D09000</Color>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>{$lua}
if syntaxcheck then return end

local req = AddressList["Required.CreateDropdown.Elements"]

[ENABLE]

req.active = true

local met = mono_findMethodBySignature("Elin", "ElementContainer", "SetBase", "int,int,int")
local ins = Recorder.getAddress(AddressList["P-&gt;Chara.elements"])
local str = Recorder.showDropdown(AddressList["Dropdown.Elements"])
local val = inputQuery(memrec.desctiption, "Generation Lv:", "1")

if not (str and val) then req.active = false; assert(req.active, "Interrupted") end

local args = {
    {type = vtDword, value = tonumber(str)},
    {type = vtDword, value = tonumber(val)},
    {type = vtDword, value = 100}
}

req.active = false

mono_invoke_method('', met, ins, args); beep(); assert(memrec.active, "Executed")

[DISABLE]
</AssemblerScript>
