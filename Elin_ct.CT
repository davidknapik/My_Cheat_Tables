                      <Options moHideChildren="1"/>
                      <Color>808080</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$lua}
if syntaxcheck then return end

local list   = AddressList["Dropdown.Policies"]
local source = Recorder.getChild(AddressList["P-&gt;SourceElement"], "P-&gt;rows")
local parent = Recorder.getChild(source, "P-&gt;_items")

local function getLanguageOffset(memrec)
    if (memrec.value == "JP") then return 0x20 end
    if (memrec.value == "EN") then return 0x28 end
    if not ((memrec.value == "JP") and (memrec.value == "EN")) then return 0x158 end
end

list.DropdownList.clear()

[ENABLE]

local base = Recorder.getAddress(parent)
local size = tonumber(Recorder.getChild(source, "_size").value)
local offs = getLanguageOffset(Recorder.getChild(AddressList["P-&gt;CoreConfig"], "lang"))

for i = 0, size - 1 do
    local ptr = readPointer(base + i * 0x08 + 0x20)
    local name = readString(readPointer(ptr + offs) + 0x14, 6000, true) or "??"
    local new  = string.gsub(name, "\n", "-&gt;")
    local alis = readString(readPointer(ptr + 0x18) + 0x14, 6000, true) or ""
    local grp = readString(readPointer(ptr + 0x70) + 0x14, 6000, true) or "??"
    if (grp == "POLICY") then list.DropdownList.add(("%s:%s"):format(alis, new)) end
end

list.DisplayAsDropDownListItem = true

[DISABLE]
</AssemblerScript>
