local function getOffset(imageName, className, memberName)
    local cid = mono_findClassByImage(imageName, className)
    local tbl = mono_class_enumFields(cid)
    for i = 1, #tbl do
        if (tbl[i].name == memberName) then return string.format("+%02X", tbl[i].offset) end
    end
end

local player = AddressList["P-&gt;Player"]

local mr = {
    Recorder.getChild(player, "P-&gt;flags"),
    Recorder.getChild(player, "P-&gt;RecipeManager"),
    Recorder.getChild(player, "P-&gt;Chara")
}

[ENABLE]

local mn = {"flags", "recipes", "chara"}

for i = 1, #mn do
    mr[i].address = getOffset("Elin", "Player", mn[i])
    mr[i].OffsetCount = 1
    mr[i].Offset[0] = 0x00
end

