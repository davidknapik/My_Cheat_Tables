                                  <ID>21335</ID>
                                  <Description>"P-&gt;mapInt"</Description>
                                  <Options moHideChildren="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
                                  <ShowAsSigned>0</ShowAsSigned>
                                  <Color>008080</Color>
                                  <GroupHeader>1</GroupHeader>
                                  <Address>+18</Address>
                                  <Offsets>
                                    <Offset>0</Offset>
                                  </Offsets>
                                  <CheatEntries>
                                    <CheatEntry>
                                      <ID>21336</ID>
                                      <Description>"Create mapInt List"</Description>
                                      <Options moDeactivateChildrenAsWell="1"/>
                                      <Color>D58F00</Color>
                                      <VariableType>Auto Assembler Script</VariableType>
                                      <AssemblerScript>{$lua}
if syntaxcheck then return end

local list = AddressList["Dropdown.CINT"]

local function findDropdownDescription(list, id)
    for i = 0, list.DropdownList.count - 1 do
        local isValid = (tonumber(list.DropDownValue[i]) == id)
        if isValid then return list.DropDownDescription[i] end
    end
end

local function createMapInt(list)
    local entr = Recorder.getChild(memrec, "P-&gt;entries")
    local base = Recorder.getAddress(entr, true)
    if not base then return end
    local size = Recorder.getChild(memrec, "_count")
    for i = 0, tonumber(size.value) - 1 do
        local id = readInteger(base + i * 0x10 + 0x28)
        local dd = findDropdownDescription(list, id)
        if not dd then return end
        local de = ("[%s] %s"):format(i, dd)
        local mr = Recorder.createChild(entr, de, ("+%02X*10+2C"):format(i))
        mr.ShowAsSigned, entr.active = true, true
    end
end

[ENABLE]

createMapInt(list)

[DISABLE]

Recorder.removeChildren(Recorder.getChild(memrec, "P-&gt;entries"))
</AssemblerScript>
