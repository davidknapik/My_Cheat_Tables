                                <CheatEntry>
                                  <ID>40376</ID>
                                  <Description>"Change Material"</Description>
                                  <Color>D09000</Color>
                                  <VariableType>Auto Assembler Script</VariableType>
                                  <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

local met = mono_findMethodBySignature("Elin", "Card", "ChangeMaterial", "int")
local ins = Recorder.getAddress(Recorder.getChild(AddressList["Owned Thing Data"], "Thing"))
local str = Recorder.showDropdown(AddressList["Dropdown.Materials"])

assert(str, "Interrupted")

local args = {{type = vtDword, value = tonumber(str)}}

mono_invoke_method('', met, ins, args); beep(); assert(memrec.active, "Executed")

[DISABLE]
</AssemblerScript>
                                </CheatEntry>
                                <CheatEntry>
                                  <ID>27749</ID>
                                  <Description>"Give Element"</Description>
                                  <Color>D09000</Color>
                                  <VariableType>Auto Assembler Script</VariableType>
                                  <AssemblerScript>{$lua}
if syntaxcheck then return end

local req = AddressList["Required.CreateDropdown.Elements"]

[ENABLE]

req.active = true

local met = mono_findMethodBySignature("Elin", "ElementContainer", "SetBase", "int,int,int")
local ins = Recorder.getAddress(AddressList["P-&gt;Thing.elements"])
local str = Recorder.showDropdown(AddressList["Dropdown.Elements"])
local val = inputQuery(memrec.desctiption, "Generation Lv:", "1")

if not (str and val) then req.active = false; assert(req.active, "Interrupted") end

local args = {
    {type = vtDword, value = tonumber(str)},
    {type = vtDword, value = tonumber(val)},
    {type = vtDword, value = 100}
}

req.active = false

mono_invoke_method('', met, ins, args); beep(); assert(memrec.active, "Executed")

[DISABLE]
</AssemblerScript>
                                </CheatEntry>
                                <CheatEntry>
                                  <ID>20042</ID>
                                  <Description>"Maximize Quantity"</Description>
                                  <Color>D58F00</Color>
                                  <VariableType>Auto Assembler Script</VariableType>
                                  <AssemblerScript>{$lua}
if syntaxcheck then return end

local parent = Recorder.getChild(AddressList["Owned Thing Data"], "Thing")

[ENABLE]

local now = Recorder.getChild(Recorder.getChild(parent, "P-&gt;ints"),       "[6] Num")
local max = Recorder.getChild(Recorder.getChild(parent, "P-&gt;_category"), "maxStack")

Recorder.writeValue(now, max); beep(); assert(memrec.active, "Executed")

[DISABLE]
</AssemblerScript>
