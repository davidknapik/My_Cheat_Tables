if syntaxcheck then return end

local parent = Recorder.getChild(memrec[0], "P-&gt;_items")

[ENABLE]

local size = tonumber(Recorder.getChild(memrec[0], "_size").value)

for i = 0, size - 1 do
    local dec = string.format("Policy[%d]", i)
    local ptr = string.format("+%02X*08+20", i)
    local hed = Recorder.createHeader(parent, dec, ptr)
    hed.OffsetCount = 1
    hed.Offset[0] = 0x00
    local id = Recorder.createChild(hed, "id", "+18")
    id.DropDownLinked = true
    id.DropDownLinkedMemrec = "Dropdown.Elements"
    Recorder.createChild(hed, "days", "+1C")
    local isAct = Recorder.createChild(hed, "active", "+20")
    isAct.type = vtByte
    isAct.DropDownLinked = true
    isAct.DropDownLinkedMemrec = "Dropdown.Boolean"
    hed.active = true
end

parent.active = true

[DISABLE]

for i = parent.count - 1, 0, -1 do parent[i].destroy() end
