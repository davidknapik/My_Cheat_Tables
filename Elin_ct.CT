if syntaxcheck then return end

[ENABLE]

local met = mono_findMethod('', 'CoreDebug', 'TestSpawn')
local ins = Recorder.getAddress(AddressList['P-&gt;CoreDebug'])
local lv  = inputQuery(memrec.desctiption, "Filter Lv:", "1")
local num = inputQuery(memrec.desctiption, "Number:"   , "1")

assert(lv and num, "Interrupted")

local args = {
    {type = vtDword, value = tonumber(lv)},
    {type = vtDword, value = tonumber(num)}
}

local msg = mono_invoke_method('', met, ins, args)

messageDialog(msg, 2, 2); assert(memrec.active, "Executed")

[DISABLE]
</AssemblerScript>
