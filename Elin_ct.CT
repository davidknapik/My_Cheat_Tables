                <CheatEntry>
                  <ID>13999</ID>
                  <Description>"Spawn Thing"</Description>
                  <Color>808080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

local dbg  = AddressList["Toggle Debug Mode"]
local req1 = AddressList["Required.CreateDropdown.Things"]
local req2 = AddressList["Required.CreateDropdown.Materials"]
local thi  = AddressList["Dropdown.Things"]
local spt  = AddressList["Required.getSpawnArgs"]

local function interrupted(arg1, arg2, arg3, arg4)
    if (arg1 and arg2 and arg3 and arg4) then return end
    req1.active, req2.active = false, false
    assert(req1.active and req2.active, "Interrupted")
end

[ENABLE]

local undo = dbg.active

dbg.active, req1.active, req2.active = true, true, true

local met = mono_findMethod('', 'CoreDebug', 'Spawn')
local ins = Recorder.getAddress(AddressList['P-&gt;CoreDebug'])
local tId = Recorder.showDropdown(thi)
local num = Recorder.inputQueryForAdd(memrec, 1)
local mat = Recorder.showDropdown(AddressList["Dropdown.Materials"])
local lvl = inputQuery(memrec.description, 'Generate Lv:', '-1')

interrupted(tId, num, mat, lvl)
Recorder.writeValue(spt[0], mat); Recorder.writeValue(spt[1], lvl)

local args = {
    {type = vtString, value = tId},
    {type = vtDword,  value = num},
    {type = vtString, value = ""}
}

req1.active, req2.active = false, false

local msg = mono_invoke_method('', met, ins, args)

dbg.active = undo

messageDialog(msg, 2, 2); assert(memrec.active, "Executed")

[DISABLE]
</AssemblerScript>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>17579</ID>
              <Description>"Global:"</Description>
              <Options moHideChildren="1"/>
              <Color>808080</Color>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>24973</ID>
                  <Description>"Must Be Best Day"</Description>
                  <Color>808080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

local var = Recorder.getChild(AddressList["DayData"], "luck")

[ENABLE]

local timer = createTimer()

local function update(timer)
    if not memrec.active then return timer.destroy() end
    Recorder.writeValue(var, 0)
end

synchronize(function() timer.onTimer, timer.interval = update, 100 end)

[DISABLE]
</AssemblerScript>
                </CheatEntry>
