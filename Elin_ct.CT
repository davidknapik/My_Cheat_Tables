                <CheatEntry>
                  <ID>39707</ID>
                  <Description>"Required.getCoreMemberOffsets"</Description>
                  <Color>808080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

local function getOffset(imageName, className, memberName)
    local cid = mono_findClassByImage(imageName, className)
    local tbl = mono_class_enumFields(cid)
    for i = 1, #tbl do
        if (tbl[i].name == memberName) then return string.format("+%02X", tbl[i].offset) end
    end
end

local core = AddressList["P-&gt;Core"]

local mr = {
    Recorder.getChild(core, "P-&gt;CoreDebug"),
    Recorder.getChild(core, "P-&gt;SourceManager"),
    Recorder.getChild(core, "P-&gt;ModManager"),
    Recorder.getChild(core, "P-&gt;CoreConfig"),
    Recorder.getChild(core, "P-&gt;Game")
}

[ENABLE]

local mn = {"debug", "sources", "mods", "config", "game"}

for i = 1, #mn do
    mr[i].address = getOffset("Elin", "Core", mn[i])
    mr[i].OffsetCount = 1
    mr[i].Offset[0] = 0x00
end

[DISABLE]
</AssemblerScript>
