if syntaxcheck then return end

local parent = Recorder.getChild(AddressList["P-&gt;Chara"], "P-&gt;_cints")

[ENABLE]

local now = Recorder.getChild(parent, parent[12].description)
local max = Recorder.getChild(parent, parent[20].description)

local timer = createTimer()

local function update(timer)
    if not memrec.active then return timer.destroy() end
    Recorder.writeValue(now, max)
end

synchronize(function() timer.onTimer, timer.interval = update, 100 end)

[DISABLE]
