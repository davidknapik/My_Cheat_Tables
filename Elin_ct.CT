if syntaxcheck then return end

local req = AddressList["Required.CreateDropdown.Policies"]

[ENABLE]

req.active = true

local met = mono_findMethodByImage("Elin", "PolicyManager", "AddPolicy", "string")
local ins = Recorder.getAddress(AddressList["P-&gt;PolicyManager"])
local pId = Recorder.showDropdown(AddressList["Dropdown.Policies"])

req.active = false

assert(pId)

mono_invoke_method("", met, ins, {{type = vtString, value = pId}})
beep(); assert(memrec.active)

[DISABLE]
</AssemblerScript>
