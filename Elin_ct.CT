                <CheatEntry>
                  <ID>40152</ID>
                  <Description>"Required.isAttached"</Description>
                  <Color>D58F00</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

local timer = createTimer(MainForm)

local function update(timer)
    if debug_isDebugging() then memrec.active = false; return timer.destroy() end
    local isAttached = readInteger("$process")
    if not (isAttached and memrec.active) then timer.destroy() end
    if not isAttached then return closeCE() end
end

synchronize(function() timer.onTimer, timer.interval = update, 100 end)

