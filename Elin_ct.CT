                        <CheatEntry>
                          <ID>40824</ID>
                          <Description>"Make Ally"</Description>
                          <Color>D09000</Color>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

local chara = Recorder.getChild(AddressList["Highlighted Character Data Modifier"], "P-&gt;Chara")
local met = mono_findMethodByImage("Elin", "Chara", "_MakeAlly")
local ins = Recorder.getAddress(chara)

mono_invoke_method('', met, ins, {{}}); beep(); assert(memrec.active, "Executed")

[DISABLE]
