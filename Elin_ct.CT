if syntaxcheck then return end

local hob = AddressList["Required.CreateDropdown.Hobbies"]
local mat = AddressList["Required.CreateDropdown.Materials"]

[ENABLE]

local ptr = Recorder.uint64_t("read_Chara_ptr+02")

