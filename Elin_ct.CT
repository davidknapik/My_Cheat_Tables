local pc  = Recorder.getChild(AddressList["P-&gt;Player"], "P-&gt;Chara")
local ele = Recorder.getChild(pc, "P-&gt;ElementContainerCard")

[ENABLE]

local timer = createTimer(MainForm)

local function update(timer)
    if not memrec.active then return timer.destroy() end
    writeQword("mem0x01+00", Recorder.getAddress(ele, true))
    writeQword("mem0x01+08", Recorder.getAddress(pc, true))
end

synchronize(function() timer.onTimer, timer.interval = update, 100 end)

