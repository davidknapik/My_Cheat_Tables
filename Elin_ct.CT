                  <Color>D09000</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

local function outputModInfo(version)
    local base = Recorder.getAddress(Recorder.getChild(AddressList["P-&gt;packages"], "P-&gt;_items"))
    local size = tonumber(Recorder.getChild(AddressList["P-&gt;packages"], "_size").value)
    printf("%s &amp; You've %s MODs.\n", version, size)
    for i = 0, size - 1 do
        local adr = readPointer(base + i * 0x08 + 0x20)
        local name = readString(readPointer(adr + 0x10) + 0x14, 6000, true)
        local ver = readString(readPointer(adr + 0x20) + 0x14, 6000, true)
        local isActive = (readBytes(adr + 0x51) == 1) and "Active:  " or "Deactive:"
        printf("%s %s v.%s", isActive, name, ver)
    end
    print("")
end

[ENABLE]

local le = getLuaEngine()
local core = AddressList["P-&gt;Core"]

le.show()
if monopipe then outputModInfo(string.format("Elin v.%s.%s", core[0].value, core[1].value)) end
writeToClipboard("[code]"..le.mOutput.lines.text.."[/code]")
messageDialog("Copied Lua Engine Output with BBCode added.", 2, 2)
assert(memrec.active, 'Executed')

[DISABLE]
