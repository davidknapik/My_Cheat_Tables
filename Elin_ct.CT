                          <CheatEntries>
                            <CheatEntry>
                              <ID>21156</ID>
                              <Description>"Create mapStr List"</Description>
                              <Options moDeactivateChildrenAsWell="1"/>
                              <Color>D58F00</Color>
                              <VariableType>Auto Assembler Script</VariableType>
                              <AssemblerScript>{$lua}
if syntaxcheck then return end

local list = AddressList["Dropdown.CSTR"]

local function findDropdownDescription(list, id)
    for i = 0, list.DropdownList.count - 1 do
        local isValid = (tonumber(list.DropDownValue[i]) == id)
        if isValid then return list.DropDownDescription[i] end
    end
end

local function createMapStr(list)
    local entr = Recorder.getChild(memrec, "P-&gt;entries")
    local base = Recorder.getAddress(entr, true)
    if not base then return end
    local size = Recorder.getChild(memrec, "_count")
    for i = 0, tonumber(size.value) - 1 do
        local id = readInteger(base + i * 0x18 + 0x28)
        local dd = findDropdownDescription(list, id)
        if not dd then return end
        local de = ("[%s] %s"):format(i, dd)
        local he = Recorder.createHeader(entr, de, ("+%02X*18+30"):format(i))
        he.OffsetCount = 1
        he.Offset[0]   = 0
        he.active      = true
        Recorder.createChild(he, "_stringLength", "+10")
        local char = Recorder.createChild(he, "_firstChar", "+14")
        char.type           = vtString
        char.String.Size    = 64
        char.String.Unicode = true
        entr.active = true
    end
end

[ENABLE]

createMapStr(list)

[DISABLE]

local entry = Recorder.getChild(memrec, "P-&gt;entries")

for i = entry.count - 1, 0, -1 do entry[i].destroy() end
