[ENABLE]
{$lua}

--[[
local startAddr = getAddress(myGame)
local endAddr = startAddr + getModuleSize(process)

function getMapCoord()
  if syntaxcheck then return end

  local addrMapChain = getAddress("pMapChain")
  local addrMapWaypt = readPointer(addrMapChain)
  if (addrMapWaypt == 0 or addrMapWaypt == nil) then
     getStaticAddr("4C 89 BC 24 80 00 00 00 48 85 F6",4,"pMapChain",0,startAddr,endAddr)
  end
  local addrMapCoord = readPointer(readPointer(readPointer(readPointer(readPointer(addrMapChain))+0x68)+0x300)+0x20)
  addrMapCoord = readPointer(readPointer(readPointer(addrMapCoord+0x70)+0xD0)+0x98)
  --print(string.format('%X',addrMapCoord))
  local addrMap = getAddress("pMappointBase")
  writeQword(addrMap,addrMapCoord)

  --print(string.format('%X',addrMap))
end

getMapCoord()
]]

