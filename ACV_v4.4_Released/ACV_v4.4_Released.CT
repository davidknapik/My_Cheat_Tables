// base coordinates...
label(code)
label(return)

newmem:
  mov rbx,[rdi+00000098]
  and eax,00007FFF
  lea edi,[rax+rax*4]
code:
  push r15
  mov r15,pMappointBase
  mov [r15],rbx
  pop r15
  jmp return

MappointBase:
  jmp far newmem
  nop
return:


// coordinates icon ~ 3 waypoints available...
// rsp+80 = rsp+A0 = setNo base
// rsp+98 = Base+F0
// rsp+170 = setNo base w/ Raven icon !
// rcx = mapicon struct...
label(code2)
label(code3)
label(code4)
label(wayp_map)
label(icon)
label(return2)
label(memCave3)
label(memCaveReturn3)


// memCave3...
$process+500+40:
memCave3:
  jmp far newmem2
return2:
  jmp memCaveReturn3
  align 10 CC

MapIcon:
  jmp memCave3
  db 90
memCaveReturn3:


newmem2:
  call qword ptr [rax+000000E0]
code2:
  push r11
  push r12
  push r13
  push r15
  // check if moving to different worldmap...
  mov r15,pWorldTrans
  mov r12,[r15]
  test r12,r12
  je code4
  mov r12,[r12]
  test r12,r12
  je code4
  lea r15,[r12+48]
  // if not v1.1.2...
  mov r13,xWorldTransOffs
  movzx r13d,word ptr [r13]
  add r15,r13
  movzx r12d,byte ptr [r15]
  cmp r12l,3
  je code4
  mov r15,pMappointBase
  mov r12,[r15]
  test r12,r12
  je code4
  // get selected waypt number...
  mov r15,nIconColor
  cmp byte ptr [r15],0x1
  jne short @f
  add r12,0x50
@@:
  cmp byte ptr [r15],0x2
  jne short @f
  add r12,0xA0
@@:
  // pMappointBase +2C
  // 0x3F800000 ~ (float)1 = no waypt
  // 0x42100000 ~ (float)36 = wayp icon
  // 0x41D00000 ~ (float)25 = wayp map | +38: 1 = wap ~ 0 = raven (rcx+200 !)
  mov r11d,dword ptr [r12+2C]
  cmp r11d,0x3F800000
  je code4
  // raven (rcx+200 !)
  mov r13d,0x0
  cmp r11d,0x42100000
  je icon
  mov r11d,dword ptr [r12+38]
  cmp r11d,(int)1
  je wayp_map
  mov r11,[rsp+190]
  mov r13d,0x1F0             // 0x200 - 0x10 (Xval (Icon))
  jmp code3
wayp_map:
  mov r11,[rsp+88]
  jmp code3
icon:
  mov r11,[rsp+150]
code3:
  cmp r11,r12
  jne code4
  mov r15,pMapIcon
  //mov [r15],rcx
  mov r11,rcx
  add r11,r13d
  test r15,r15
  je code
  mov [r15],r11
code4:
  pop r15
  pop r13
  pop r12
  pop r11
  jmp return2


