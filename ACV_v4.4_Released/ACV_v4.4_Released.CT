            <CheatEntry>
              <ID>97398</ID>
              <Description>"Ignore Fall Damage"</Description>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : ACValhalla.exe
  Version: 
  Date   : 2023-10-12
  Author : Paul44

  Dis/enable fall damage...
  (basically execute al = 0)
  Note: it looks like 'godmode' also sets this flag...
}

[ENABLE]

aobscanmodule(FallDamage,$process,48 8B 47 28 48 8D 54 24 6C 48 89 9C 24 30 04 00 00)
registersymbol(FallDamage)
alloc(newmem,$100)

aobscanmodule(FallDamageJmp,$process,48 8B 4F 28 45 33 C0 C6 87 73)
registersymbol(FallDamageJmp)

aobscanmodule(BipedComp,$process,48 89 84 24 90 00 00 00 48 8B F9 48 8B DA 48 8B 49)
registersymbol(BipedComp)
alloc(newmem2,$100)

globalalloc(pBipedComp,8)


label(code)
label(return)

newmem:
  // check type of damage - or check teleport flag - or...
  // +C8 = 0...
  push r15
  mov r15,pEntity
  cmp [r15],rsi
  jne code
  // falling...?
  mov r15,pBipedComp
  mov r15,[r15]
  cmp byte ptr [r15+131],0
  jne code
  pop r15
  jmp FallDamageJmp
code:
  pop r15
@@:
  mov rax,[rdi+28]
  lea rdx,[rsp+6C]
  mov [rsp+00000430],rbx
  jmp return

FallDamage:
  jmp far newmem
  nop 3
return:

// contains fall info...
label(code2)
label(return2)

newmem2:
  push r15
  mov r15,pEntity
  mov r15,[r15]
  cmp r15,[rcx+18]
  jne code2
  mov r15,pBipedComp
  mov [r15],rcx
code2:
  pop r15
@@:
  mov [rsp+00000090],rax
  mov rdi,rcx
  mov rbx,rdx
  jmp return2

BipedComp:
  jmp far newmem2
return2:


[DISABLE]

FallDamage:
  db 48 8B 47 28 48 8D 54 24 6C 48 89 9C 24 30 04 00 00

unregistersymbol(FallDamage)
unregistersymbol(FallDamageJmp)
dealloc(newmem)

BipedComp:
  db 48 89 84 24 90 00 00 00 48 8B F9 48 8B DA

unregistersymbol(BipedComp)
dealloc(newmem2)

