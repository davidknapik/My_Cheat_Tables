{$lua}

  nFallmr = readInteger(getAddress('nFallId'))
  local nId = readBytes(getAddress('bUseGodmode'))
  if nId == 1 then nFallmr = readInteger(getAddress('nGodId')) end


--[[
  getStaticAddr("41 8B D2 89 4C 24 20 48 8D",-10,"pMapPinBase",0)

function getMapPinCoord()
  local addrMapPinCoord = readPointer(getAddress("[pMapPinBase]"))
  local addrPin = readPointer(addrMapPinCoord+0x8)
  addrPin = readPointer(readPointer(readPointer(readPointer(addrPin+0x20)+0x0)+0x10)+0x28)
  addrPin = readPointer(readPointer(addrPin+0xC4)+0x20)

  local aPinMap = getAddress("pMapPinCoord")
  writeQword(aPinMap,addrPin)
  --print(string.format('%X',addrPin))
end
]]

