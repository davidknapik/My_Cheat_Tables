// init script variables
globalalloc(XYstepVal,4)
globalalloc(ZstepVal,4)
globalalloc(ZstepdropHeight,4)

globalalloc(Xval,4)
globalalloc(Yval,4)
globalalloc(Zval,4)
globalalloc(bFreeRoam,1)
//globalalloc(pCamera,8)
globalalloc(bCoordSave,1)
globalalloc(bCoordRestore,1)
globalalloc(nFrameSpeed,4)

// cam distance
globalalloc(pFreeCam,8)
globalalloc(FOVCam,4)

// fill in offset here ~ see table coordinates...
pStructCrdOffset:
dd 50

bDropHigh:
db 00
nIconColor:
db 00
nIconNumber:
db 00
bFreeRoam:
db 00
// save_restore coordinates...
bCoordSave:
db 1
bCoordRestore:
db 0

nIconHeight:
dd 40400000                        // (float)3.0
nDropHeight:
dd 40400000                        // (float)3.0
// dd 0x41A00000                         // = 20.0
XYstepVal:
dd 40000000                        // (float) 2.0
ZstepVal:
dd 3F800000                        // (float) 1.0
ZstepdropHeight:
dd 3F800000

// freeroam timer interval (smoother/faster = 50 - smoothest/fast = 20)
// choose between player or camera
nFrameSpeed:
dd #50


label(code)
label(return)

// subroutines...
alloc(updateCrd,$100)

updateCrd:
  // updated coordinates...
  push r15
  mov r15,pStructCrdBase
  mov rbx,[r15]
  mov r15,pStructCrdOffset
  add rbx,[r15]
  mov r15,Xval
  mov edx,dword ptr [r15]
  mov [rbx],edx
  add rbx,4
  mov r15,Yval
  mov edx,dword ptr [r15]
  mov [rbx],edx
  add rbx,4
  mov r15,Zval
  mov edx,dword ptr [r15]
  mov [rbx],edx
  pop r15
  ret

// Player roaming...
newmem:
{$try}
  push rbx
  push rcx
  push rdx
  push r15
  mov r15,bFreeRoam
  cmp byte ptr [r15],1
  jne code
  // freeroam routines...
  mov r15,pEntity
  mov rbx,[r15]
  //sub rbx,0x20
  cmp rbx,rcx
  jne code
  mov r15,pStructCrdBase
  mov [r15],rbx
  // updated coordinates...
  mov r15,updateCrd
  call r15
  mov r15,pStructCrdBase
  mov rbx,[r15]
  movaps xmm1,[rbx+50]
  movaps [rax+30],xmm1
  jmp code
{$except}
  mov r15,nCrash4
  inc [r15]
code:
  pop r15
  pop rdx
  pop rcx
  pop rbx
@@:
  movaps xmm1,[rax+30]
  movups [rcx+50],xmm1
  ret
  int 3
  int 3
  int 3
  int 3
  int 3
  jmp return

Coord:
  jmp far newmem
return:


