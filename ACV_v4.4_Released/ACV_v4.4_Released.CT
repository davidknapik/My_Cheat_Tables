  Author : Paul44

  HowTo: Teleporting...
}

[ENABLE]

{$lua}
  local sMessage = [[
 1.  Open map (always use same/selected Waypoint number)
 2.  Select your location on the map,
      then wait a few seconds (to collect icon info)...
 3.  Next, press [Ctrl+P] once (or twice) to update
      your player coordinates ...!
      (if done correctly, the player icon should reposition)
 4.  Press [ESC] to teleport to that particular location
      (see also [Readme] file)

 Note: do not forget to enable [God mode] first.
 Tip: best teleport while in Fullscreen.
  ]]

  showMessage(sMessage)

return error()

