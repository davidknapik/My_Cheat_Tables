  pop r15
  pop rbx
@@:
  mov rax,[rcx]
  call qword ptr [rax+000000F0]
  mov rcx,[rax]
  mov rax,[rcx+08]
  jmp return

Inventory:
  jmp far newmem
  nop 2
return:


[DISABLE]

