              <AssemblerScript>{ Game   : ACValhalla.exe
  Version: 
  Date   : 2020-07-27
  Author : Paul44

  Manage camera distance to player ~ FOV...
  (see also ACS table)
}

[ENABLE]
// ACUPlayerCameraComponent...
aobscanmodule(FreeCam,$process,F3 41 0F 11 86 80 00 00 00 0F 58 DA 41 0F 11 5E 70)
registersymbol(FreeCam)
alloc(newmem,$100)

// default value: 0.7853981853 ~ or [3F490FDB]
FOVCam:
dd 3F490FDB

label(code)
label(return)

newmem:
  push r15
  mov r15,pFreeCam
  mov [r15],r14
  mov r15,FOVCam
  movss xmm0,[r15]
  pop r15
code:
  movss [r14+00000080],xmm0
  addps xmm3,xmm2
  movups [r14+70],xmm3
  jmp return

FreeCam:
  jmp far newmem
  nop 3
return:


[DISABLE]

FOVCam:
dd 3F490FDB

FreeCam:
  db F3 41 0F 11 86 80 00 00 00 0F 58 DA 41 0F 11 5E 70

unregistersymbol(FreeCam)
