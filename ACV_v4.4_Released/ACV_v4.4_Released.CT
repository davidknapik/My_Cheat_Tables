    <CheatEntry>
      <ID>1993</ID>
      <Description>"Enable Cheats... (after save has fully loaded)"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <LastState/>
      <Color>808000</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : ACValhalla.exe
  Version:
  Date   : 2021-03-17
  Author : Paul44

  Collects main pointer values...
}

[ENABLE]
// structs: +38 .. +18
// BhvAssassin: +58 +0 +68 +50 +140 +2F0 +0
// +12: Entity...
// +18: World .. +450
// BhvAssassin... +60:CharacterAI .. (?) +410:CSrvBlending .. +3D0: CSrvHealth...
// Stamina: (world +138 +0:Bhvass +68:Human +C8 +D8 +150 +AD4
{$lua}

local startAddr = getAddress(myGame)
local endAddr = startAddr + getModuleSize(process)

-- or else crashes game while teleporting w/ debugger attached -  see also 'Scripts to run per Timer interval'
unregisterSymbol("pMappointBase")
unregisterSymbol("xWorldTransOffs")
if not getAddressSafe("xWorldTransOffs") then registerSymbol("xWorldTransOffs", allocateMemory(2)) end

local addrWorldTransOffs = getAddress('xWorldTransOffs')
writeSmallInteger(addrWorldTransOffs,0x18)

-- not used...
function GetBhvChain()
  local addrBhvChain = getAddress("pBhvChain")
  getStaticAddr("83 B8 00 01 00 00 00 0F 9F",7,"pBhvChain",0,startAddr,endAddr)
end

function CollectPtrs()
  --if syntaxcheck then return end

  local addrWorldTrans = getAddressSafe("[[pWorldTrans]]")
  local nWorldTransOffs = readSmallInteger(getAddress('xWorldTransOffs'))
  local bInTrans = 0
  if ( addrWorldTrans ~= nil and addrWorldTrans ~= 0) then
     -- bInTrans = readBytes(addrWorldTrans+0x48)                -- till v1.5.1
     bInTrans = readBytes(addrWorldTrans+0x48+nWorldTransOffs)
  end
  if( bInTrans == 3 ) then return end

--[[
  local addrBhvChain = getAddress("[pBhvChain]")
  addrBhvChain = readPointer(addrBhvChain)

  local addrBhvAss = readPointer(readPointer(readPointer(readPointer(addrBhvChain+0x58)+0x0)+0x68)+0x50)
  addrBhvAss =  readPointer(readPointer(readPointer(addrBhvAss+0x140)+0x2F0)+0x0)
  --print(string.format('%X',addrBhvAss))
  local aBhvAss = getAddress("pBhvAssassin")
  writeQword(aBhvAss,addrBhvAss)

  local addrEntity = readPointer(addrBhvAss+0x18)
  local aEntity = getAddress("pEntity")
  writeQword(aEntity,addrEntity)

  -- BhvAss: +60 +18C +80
  local addrStructs = readPointer(readPointer(readPointer(readPointer(readPointer(addrEntity+0x18)+0x298)+0x0)+0x60)+0xDC)
  local addrHealth = readPointer(addrStructs+0xB0)
  local aHealth = getAddress("pHealth")
  writeQword(aHealth,addrHealth)
  local aHealthVFT1 = getAddress("pHealthVFT1")
  local aHealthVFT2 = getAddress("pHealthVFT2")
  writeQword(aHealthVFT1,readPointer(addrHealth))
  writeQword(aHealthVFT2,readPointer(addrHealth+0x88))

  local addrStamina = readPointer(readPointer(readPointer(readPointer(addrBhvAss+0x68)+0xC8)+0xD8)+0x158)
  local aStamina = getAddress("pStamina")
  writeQword(aStamina,addrStamina)

  --local addrAdrenalin = readPointer(readPointer(readPointer(addrBhvAss+0x60)+0x18C)+0x18)
  --local aAdrenalin = getAddress("pAdrenalin")
  --writeQword(aAdrenalin,addrAdrenalin)

  --local addrOxygen = readPointer(readPointer(readPointer(addrBhvAss+0x48)+0x84)+0x18)
  --local aOxygen = getAddress("pOxygen")
  --writeQword(aOxygen,addrOxygen)
]]--

  local addrBhvAss = getAddressSafe("[pBhvAssassin]")
  --local addrEntity = readPointer(addrBhvAss+0x18)
  --local aEntity = getAddress("pEntity")
  --writeQword(aEntity,addrEntity)
  local addrInvis = getAddress("bInvisible")
  if (addrBhvAss ~= nil) then writeBytes(addrBhvAss+0x7E,readBytes(addrInvis)) end

  local addrHealth = getAddressSafe("[pHealth]")
  local addrGod = getAddress("bGodmode")
  if (addrHealth ~= 0 and addrHealth ~= nil) then
      writeBytes(addrHealth+0x15C,readBytes(addrGod))
      local aHealthVFT1 = getAddress("pHealthVFT1")
      local aHealthVFT2 = getAddress("pHealthVFT2")
      writeQword(aHealthVFT1,readPointer(addrHealth))
      writeQword(aHealthVFT2,readPointer(addrHealth+0x88))
  end
  --print(string.format('%X',addrStamina))

  if ( addrWorldTrans == nil or addrWorldTrans == 0) then
    -- '48 8B 00 48 3B 86 20 01 00 00',-19
    -- '48 89 5C 24 10 56 48 83 EC 20 80 79 20 00 48 8B D9',-20
    getStaticAddr("48 8B 00 48 3B 86 20 01 00 00",-16,"pWorldTrans",0,startAddr,endAddr)
  end
end


{$asm}

// to be used by MemCave...
fullAccess($process+500,$200)

// BhvAssassin...
aobscanmodule(BhvAssassin,$process,48 8B 41 60 48 8D 54 24 40 48 89 5C 24 78)
registersymbol(BhvAssassin)
alloc(newmem,$100)

// CSrvHealth...
aobscanmodule(Health,$process,8B BB 38 01 00 00 75)
registersymbol(Health)
alloc(newmem2,$100)


// needed for 'Enable cheats...' script
globalalloc(pBhvChain,8)
globalalloc(pBhvAssassin,8)
globalalloc(pEntity,8)
globalalloc(pHealth,8)
globalalloc(pStamina,8)
globalalloc(pAdrenalin,8)
globalalloc(pInventory,8)
globalalloc(bInvChoice,4)
globalalloc(pInvTable,$200)    // used in Inventory script to record offsets... (= 64x8)
globalalloc(pAddrItem,8)
globalalloc(pSkillProgress,8)
globalalloc(pSkillExperience,8)
globalalloc(pRaidCargo,8)

globalalloc(bUseGodmode,1)
globalalloc(nFallId,4)
globalalloc(nGodId,4)

// check disables autorun functions during loading, map transition, etc...
globalalloc(pWorldTrans,8)

// get static Time of day...
globalalloc(pTimeOfDay,8)
// progress thresholds...
globalalloc(pProgressMgr,8)

globalalloc(bGodmode,1)
globalalloc(bInvisible,1)

// 1-hit kill
globalalloc(pHealthVFT1,8)
globalalloc(pHealthVFT2,8)

// Map Pin waypoint coordinates ~ Teleport...
globalalloc(pMapPinBase,8)
globalalloc(pMapPinCoord,8)

// Inventory ~ special reporting...
globalalloc(pEconomSet,8)
globalalloc(sReportSep,1)

// 'Player Coordinates' script
// x64 pointers are 8-bytes long
globalalloc(pStructCrdBase,8)
globalalloc(pStructCrdOffset,8)

// Error stats...
globalalloc(nCrash1,4)
globalalloc(nCrash2,4)
globalalloc(nCrash3,4)
globalalloc(nCrash4,4)

// get game version...
globalalloc(pVersion,8)
globalalloc(sVersion,50)

// inventory...
globalalloc(nMaxQuantity,4)
// progression skills...
globalalloc(pProgressSkill,8)

// yaw &amp; pitch...
globalalloc(pCamera,8)

nMaxQuantity:
dd 63

nCrash1:
dd 0
nCrash2:
dd 0
nCrash3:
dd 0
nCrash4:
dd 0

bGodmode:
db 0
bInvisible:
db 0
bUseGodmode:
db 0

nFallId:
dd #97398
nGodId:
dd #106

//luacall(GetBhvChain())
luacall(CollectPtrs())

// see [Maintenance scripts ~ 'special' scripts] (x3)..
globalalloc(bInverseXY,1)

bInverseXY:
db 0


// BhvAssassin...
label(code)
label(return)

newmem:
  push r14
  push r15
  mov r15,pBhvAssassin
  mov [r15],rcx
  test rcx,rcx
  je code
  mov r15,[rcx+18]
  mov r14,pEntity
  mov [r14],r15
code:
  pop r15
  pop r14
@@:
  mov rax,[rcx+60]
  lea rdx,[rsp+40]
  mov [rsp+78],rbx
  jmp return

BhvAssassin:
  jmp far newmem
return:


// Health...
label(code2)
label(return2)
label(memCave)
label(memCaveReturn)

// memCave1...
$process+500:
memCave:
  jmp far newmem2
return2:
  jmp memCaveReturn
  align 10 CC

Health:
  jmp memCave
  db 90
memCaveReturn:


newmem2:
  push r15
  mov r15,pHealth
  mov [r15],rbx
  pop r15
code2:
  mov edi,[rbx+00000138]
  jmp return2


[DISABLE]

// BhvAssassin...
BhvAssassin:
  db 48 8B 41 60 48 8D 54 24 40 48 89 5C 24 78

unregistersymbol(BhvAssassin)
dealloc(newmem)

// Health...
Health:
  db 8B BB 38 01 00 00

unregistersymbol(Health)
dealloc(newmem2)


