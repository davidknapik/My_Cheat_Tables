            <CheatEntry>
              <ID>0</ID>
              <Description>"1-Hit Kill/Defense Enemy..."</Description>
              <Options moHideChildren="1" moManualExpandCollapse="1" moDeactivateChildrenAsWell="1"/>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : ACValhalla.exe
  Version: 
  Date   : 2023-04-28
  Author : Paul44

  Sets health/stun values to a (lower) max for enemies...
}

[ENABLE]

aobscanmodule(HealthEnemy,$process,48 81 C1 A8 FD FF FF 48 8B DA 48 8B 01 FF 90 10 01 00 00)
registersymbol(HealthEnemy)
alloc(newmem,$200)

aobscanmodule(StunEnemy,ACValhalla.exe,8B B6 3C 01 00 00 48 8B 91 88 0B 00 00 48 8B 4A 08)
registersymbol(StunEnemy)
alloc(newmem2,$100)

globalalloc(pHealthEnemy,8)

// set enemy health to 10 ~ 1-shot kill...
nHealthMax:
dd (int)10

// sets enemy stun value to 'Stun/nStunChunk'
// 1 = instant Stun ~ 5 = 'Stunvalue/5'-hit ~ 0 = normal
nStunMax:
dd (int)10

bHealthFriendly:
dd 0x0


label(code)
label(code11)
label(return)

newmem:
  // +10 = 0x0031800A ~ CSrvNPC_Health record (friendly, player, enemy, animal, npc,...)
  // +10 + 0X00318000 = enemy ?
  // +10 = 0x0031800E ~ CSrvNPC_Zealot
  add rcx,FFFFFFFFFFFFFDA8                               // -600 = health_value...
  mov rbx,rdx
  mov rax,[rcx]
  call qword ptr [rax+00000110]
@@:
  push r8
  push r15
  // entity = dead
  cmp dword ptr [rcx+138],FFFFFFFF
  je code11

  // CharacterAI...
  mov r15,[rcx+70]
  test r15,r15
  je code11
  mov r15,[r15+240]
  test r15,r15
  je code11
  // Faction...
  mov r15,[r15]
  test r15,r15
  je code11
  // 1D = npc ? - 2D = crew/player...
  // 17 = domestic animals - friendlies ?
  // 21 = npc_city
  // 15 = enemies...
  cmp byte ptr [r15+46],17
  je code
  cmp byte ptr [r15+46],21
  je code
  cmp byte ptr [r15+46],2D
  je code
  mov r15,pHealthEnemy
  mov [r15],rcx
  // set healthmax...
  xor r8,r8
  mov r15,nHealthMax
  mov r8d,dword ptr [r15]
  cmp r8d,0
  jbe code11
  cmp dword ptr [rcx+138],r8d
  jbe code11
  mov dword ptr [rcx+138],r8d
  jmp code11
code:
  // godmode flag +15C?
  //mov r15,pHealthFriendly
  //mov [r15],rcx
  mov r15,bHealthFriendly
  cmp byte ptr [r15],1
  jne code11
  mov r8d,[rcx+13C]
  mov dword ptr [rcx+138],r8d
code11:
  pop r15
  pop r8
  jmp return

HealthEnemy:
  jmp far newmem
  nop 5
return:


// stun enemy...
label(code2)
label(return2)

newmem2:
  push rbx
  push r15
  mov r15,nStunMax
  mov ebx,dword ptr [r15]
  cmp ebx,0
  jbe code2
  // CharacterAI...
  mov r15,[rsi+08]
  test r15,r15
  je code2
  mov r15,[r15+240]
  test r15,r15
  je code2
  // Faction...
  mov r15,[r15]
  test r15,r15
  je code2
  // 1D = npc - 2D = crew ~ player
  //cmp byte ptr [r15+46],1D
  //je code2
  cmp byte ptr [r15+46],2D
  je code2
  // set stunmax...
  cmp dword ptr [rsi+13C],ebx
  jbe code2
  mov [rsi+13C],ebx
code2:
  pop r15
  pop rbx
@@:
  mov esi,[rsi+0000013C]
  mov rdx,[rcx+00000B88]
  mov rcx,[rdx+08]
  jmp return2

StunEnemy:
  jmp far newmem2
  nop 3
return2:


[DISABLE]

HealthEnemy:
  db 48 81 C1 A8 FD FF FF 48 8B DA 48 8B 01 FF 90 10 01 00 00

unregistersymbol(HealthEnemy)
dealloc(newmem)

StunEnemy:
  db 8B B6 3C 01 00 00 48 8B 91 88 0B 00 00 48 8B 4A 08

unregistersymbol(StunEnemy)
dealloc(newmem2)

