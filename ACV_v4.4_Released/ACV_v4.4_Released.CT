globalalloc(fTimeHugr,4)

fTimeHugr:
dd 42700000              // (float)60

label(code)
label(return)

newmem:
  push r15
  mov r15,fTimeHugr
  mov r15d,dword ptr [r15]
  mov [rcx+00000114],r15d
  pop r15
code:
  movss xmm0,[rcx+00000114]
  ret 
  int 3 
  int 3 
  int 3 
