              <LastState/>
              <Color>000000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript Async="1">{ Game   : ACValhalla.exe
  Version: 
  Date   : 2021-03-01
  Author : Paul44

  Collects inventory Upgrade &amp; Potions values...
}

[ENABLE]
// World: +6A8 .. +0 .. +544 .. +40 .. +90 .. +160 .. +F60: Inventory...
// CharacterAI: +3D0 .. +2A0 .. +130: Inventory...
// CharacterAI: +3F0 .. +1E0 .. +94: Inventory...
// CharacterAI: +3E0 .. +128 .. +3F8 .. +140: Inventory...
// CharacterAI: +288 .. +140 .. +18 .. +280: Inventory...
// CharacterAI: +DC .. +88 .. +90 .. +280: Inventory...
// World: +2F0 .. +0 .. (BhvAssassin) +60 .. +3F8 .. +130: Inventory...
{$lua}
local f = nil
local nChoice = 0
local sMsg = ''
local sInfo = ''
local sListItems
addrStruct = ''
strStruct = ''


local bGetDescr = 1

local function setMaxValue()
  local nMaxQ = readInteger(getAddress('nMaxQuantity'))
  local lBox = f.ListBox
  for i=0,lBox.Items.Count-1 do
      local sItem = lBox.Items[i]
      local addrItem = sItem:match("{(.-)}")
      addrItem = tonumber(addrItem,16)

      local nPos = 43
      local nPosAddr,_ = string.find(sItem,"}")
      local sAddrInfo = string.sub(sItem,0,nPosAddr+1)
      local hUniqueID = string.sub(sItem,nPos,nPos+15)
      hUniqueID = string.gsub(hUniqueID, '^%s*(.-)%s*$', '%1')
      local sDescr = string.sub(sItem,nPos+16,string.len(sItem))
      local nTotal = readInteger(addrItem+0x0)
      nTotal = math.max(nTotal,nMaxQ)
      writeInteger(addrItem+0x00,nTotal)

      local sName = string.format('%s  %7d    %12s%s',
                        sAddrInfo,nTotal,hUniqueID,sDescr)
      lBox.Items[i] = sName
  end
end


-- stackoverflow: “Bitwise AND” in Lua
local OR, XOR, AND = 1, 3, 4

function bitOper(a, b, oper)
   local r, m, s = 0, 2^31
   repeat
      s,a,b = a+b+m, a%m, b%m
      r,m = r + m*oper%(s-a-b), m/2
   until m &lt; 1
   return math.floor(r)
end

local nChoice = readBytes(getAddress("bInvChoice"))

local addrSeperator = getAddress("sReportSep")
local sSep = readString(addrSeperator,2)
if (sSep == nil or sSep == '') then sSep = ' ' end

local startAddr = getAddress(myGame)
local endAddr = startAddr + getModuleSize(process)

-- Special reports ~ Item lists...
local addrEconomSet = getAddress("pEconomSet")
getStaticAddr("48 8D 8E 28 02 00 00 4C 89 75",7,"pEconomSet",0,startAddr,endAddr)
--print(string.format('{%X}',readPointer(readPointer(addrEconomSet))))


function removeDuplicates_v1(sender)
  local f = sender
  if (f.Name == 'RecycleBin') then f = sender.Parent end
  if (f.ListBox.Items.Count &lt; 1) then return end
  local sText = 'Do you want to remove all Duplicate Items now...? \n\n' ..
                'Note 1: To finalize "Removing Duplicates", you must Save and then Reload that same Save ! \n' ..
                'Note 2: To undo your action, just simply reload your last Save instead...'
  local nResult = messageDialog(sText, mtInformation, mbYes, mbCancel)
  if not (nResult == 6) then return end

  -- 5:Remove Duplicates
  sListItems = createStringList()
  CollectInventory(5)                  -- set as "removed"...
  f.close()
  --nChoice = 4
  --sListItems = createStringList()
  --CollectInventory(4)                  -- refressh list...
end

function removeDuplicates_v2(sender)
  local f = sender
  if (f.Name == 'RecycleBin') then f = sender.Parent end
  if (f.ListBox.Items.Count &lt; 1) then return end
  local sText = 'Do you want to remove all Duplicate Items now...? \n\n' ..
                'Note 1: To finalize "Removing Duplicates", you must Save and then Reload that same Save ! \n' ..
                'Note 2: To undo your action, just simply reload your last Save instead...'
  local nResult = messageDialog(sText, mtInformation, mbYes, mbCancel)
  if not (nResult == 6) then return end

  local lBox = f.ListBox
  for i=0,lBox.Items.Count-1 do
      local sItem = lBox.Items[i]
      local addrItem = sItem:match("{(.-)}")
      addrItem = tonumber(addrItem,16)
      local sIdxOffs = string.sub(sItem,0,13)

      local nPosID,_ = string.find(sItem,"*")
      local hUniqueID = string.sub(sItem,nPosID+1,nPosID+20)
      local sDescr = string.sub(sItem,nPosID+21,string.len(sItem))
      local nTotal = 0
      writeInteger(addrItem+0x00,nTotal)

      local sName = string.format('%s:  {%14X}   %7d  %s%12s%s',
                        sIdxOffs,addrItem,nTotal,"*",hUniqueID,sDescr)

      lBox.Items[i] = sName
  end
end


function CollectInventory(nFormChoice)
  nChoice = nFormChoice or nChoice

  local addrInventory = getAddress("[pInventory]")
  local checkCat = readPointer(addrInventory+0x0C)
  checkCat = readPointer(readPointer(readPointer(checkCat+0x38)+0x0))
  local addrInvTable = getAddress("pInvTable")          -- [ $200 = 64 x 8 ] bytes...
  --print(string.format('%X',addrInventory))

  local rangeList = readInteger(addrInventory+0x14)
  local a = rangeList
  local b = 0x00007FFF
  rangeList = bitOper(a,b,AND)
  --print(string.format('%X',rangeList))
  --rangeList = 0x200
  addrInventory = readPointer(addrInventory+0x0C)

  local mRecPlaceH = {
    [0x01BFDB9F655] = {1,1,"Silver"},
    [0x0] = {0,2,"Opal"},
    [0x183257CB6A1] = {1,3,"Supplies","Cargo_Common"},
    [0x183257CB6A2] = {1,4,"Raw Materials","Cargo_Rare"},

    [0x1AF7031F403] = {1,5,"Leather"},
    [0x1AF7031F3F9] = {1,6,"Iron Ore"},
    [0x1C7BCD89F93] = {1,7,"Fabric"},
    [0x1C7BCD89F8E] = {1,8,"Titanium"},
    [0x1AF70363CAF] = {1,9,"Carbon Ingot","Ingot_Refined"},
    [0x1AF70363CB0] = {1,10,"Nickel Ingot","Ingot_Superior"},
    [0x1AF70363CB1] = {1,11,"Tungsten Ingot","Ingot_Flawless"},
    [0x1E9BC55CE53] = {1,12,"Platinum Ingot","Ingot_Divine"},

    [0x043E344147B] = {1,13,"Hunter Arrows"},
    [0x1CAC79270DF] = {1,14,"Light Arrows"},
    [0x1CAC79270D8] = {1,15,"Predator Arrows"},
    [0x1A13AA94F85] = {1,16,"Rations","HealthConsumable"},

    [0x1CC6ABA0D4C] = {1,17,"Foreign Supplies I","Foreign Cargo"},
    [0x1E08F788505] = {1,18,"Mastery Energy","Gold_Mastery"},
    [0x1E08F7884F1] = {1,19,"Battle Energy","Silver_Mastery"},
    [0x1D64A571317] = {1,20,"Infamy","Rebels"},
    [0x1CB14D75737] = {1,21,"Luxuries","Infamy Level"},
    [0x1D752810B1C] = {1,22,"Trade Material Supplies","IrishCargo"},

    [0x1C7BCDBBE50] = {1,23,"Order Ancients Medallion"},
    [0x1AF70362E4E] = {1,24,"Roman Artifact"},

    [0x1E274709F8F] = {1,25,"Silica"},
    [0x1E90CD92AAB] = {1,26,"Giant Feather","Carbonite"},
    [0x1E9A8E5E1A9] = {1,27,"Magma Blood","Carbonite"},
    [0x1E9A8E5E1AF] = {1,28,"Jotun Seidr","Carbonite"},
    [0x1E9A8E5E1B5] = {1,29,"Frozen Blood","Carbonite"},
    [0x1E9A8E5E1A3] = {1,30,"Living Spark","Carbonite"},

    [0x1C180FBD005] = {1,31,"Festival Tokens","Yule Token"},
    [0x1D64A570AF4] = {1,32,"Silver Deniers","Rebel Money"},
    [0x1C78D91433C] = {1,33,"Texts","Culture"},
    [0x1C78D914115] = {1,34,"Delicacies"},
    [0x1E9A8E32613] = {1,35,"Mupelsheim","Muspel Core"},
    [0x1D1D09DC4F3] = {1,36,"Foreign Supplies II","Foreign_Cargo"},
    [0x1C78D91434B] = {1,37,"Clothing","Textiles"},
    [0x1E82D13E204] = {1,38,"Token Of Kara","Arena Tokens"},
    [0x1E796396234] = {1,39,"Hugr","Odin Power - Hugr"},

    [0x1F01E97EC53] = {1,40,"Memories","PermanentRessource_1"},
    [0x1F01E97F582] = {1,41,"Coins","TemporaryRessource_1"},
    [0x1F01E986384] = {1,42,"Dreams","DreamCurrency"},
    [0x1F01E97F588] = {1,43,"Gems","TemporaryRessource_2"},
    [0x1F01E97EC4E] = {1,44,"Thoughts","PermanentRessource_2"},
    [0x1E82D13252C] = {1,45,"Uncut Gemstone","Uncut Gemstone"}
    }
  local nResourceMax = 0
  for k,v in pairs(mRecPlaceH) do
      nResourceMax = nResourceMax + v[1]
  end

  -- see Form Recyclebin fn...
  execStruct = nil
  execRoutine = removeDuplicates_v2
  if (nChoice == 2) then execRoutine = setMaxValue end

  sMsg = 'List Resources'
  sInfo = ''
  if (nChoice &gt; 1) then
     if (nChoice == 3) then sMsg = 'List Full Inventory' end
     if (nChoice == 4) then sMsg = 'List Duplicates' end
     if (nChoice == 5) then sMsg = 'List Full Inventory (All)' end

     -- google: cheat engine Async exec Form invalid window handle
     synchronize(function()
         -- painting form...
         f = IconList
         f.Width = 1000
         f.Height = 800
         if (nChoice == 2) then f.Height = 500 end
         f.Show()
         f.Caption = 'ACV - Inventory Items...'
         local lBox = f.ListBox
         lBox.Clear()
         local lbTitle = f.IconTitle
         lbTitle.Caption = 'One moment please... processing...'
         local lbInfo = f.IconInfo
         lbInfo.Caption = ''
         local lbHead = f.IconHead
         lbHead.Caption = '    #   Offset         AddrItem        Total        UniqueID                    Category   Description'
         local lbMsg = f.IconMessage
         lbMsg.Caption = "See Readme on how to manage \n and use this info..."
         --lbMsg.Visible = true
         local cbGod = f.GodMode
         f.GodMode.Caption  = 'God Mode:'
         -- hide info...
         f.pCoord.Visible = false
         f.Structure.Visible = false
         f.RecycleBin.Visible = false
         f.RecycleBin.Anchors = 'akTop,akRight'
         f.RecycleBin.BorderSpacing.Right = 60

         sInfo = string.format('Inventory: %X ~ [%X] ~ {%d}',addrInventory,getAddress(myGame),rangeList)
          --local sInfo = string.format('   #   Offset %s     AddrItem   %s         %s       UniqueID  %s                        Category %s       SubCat'
          --        ,sSep,sSep,sSep,sSep,sSep)

         if (nChoice == 2 or nChoice == 3 or nChoice == 5) then
             aStructGui = {'AC Valhalla - Edit Item Total','Item_Total',450,200,false,150,200}
             aStructInfo = { {'Total',0x0,vtDword,true} }
             f.Structure.Visible = true
             if (nChoice == 2) then
                 f.RecycleBin.Visible = true
                 f.RecycleBin.Hint = 'Set item values to a MaxQuantity...'
                 f.Height = 600
             end
         end
         if (nChoice == 4) then
             f.Height = 500
             f.RecycleBin.Visible = true
             --f.RecycleBin.Right = 25
             f.RecycleBin.Anchors = 'akTop,akRight'
             f.RecycleBin.BorderSpacing.Right = 20
         end
     end)
  end

  local bContinue = true
  local nStruct = 0x48
  local nCount = 0
  local nResource = 0
  local aItems = {}
  while bContinue do
        local addrResource = addrInventory + nStruct * nCount
        --print(string.format('%X',addrResource))

        -- no need to build/parcour array when only collecting resource info...
        if ( nChoice == 1 ) then
           local kUniqueID = readPointer(readPointer(addrResource+0x8)+0x10)
           --local sItem = ''
           --sItem2 = readPointer(readPointer(readPointer(addrResource+0x38)+0x0)+0x18)
           --if (sItem2 ~= 0) then sItem = readString(readPointer(readPointer(readPointer(sItem2))+0x10),20) end
           local mRec = mRecPlaceH[kUniqueID]
           if (mRec ~= nil) then
              writeQword(addrInvTable + 8 * (mRec[2] - 1),addrResource)
              nResource = nResource + 1
              if (nResource &gt;= nResourceMax) then break end
           end
        else
            local kUniqueID = readPointer(readPointer(addrResource+0x8)+0x10)
            kUniqueID = string.format('%12X_%04X',kUniqueID,nCount)
            local aElem = {kUniqueID, string.format('%X',addrResource)}
            if ( nChoice == 3  or nChoice == 5) then
               local sItem = ''
               local sItem1 = readPointer(readPointer(readPointer(addrResource+0x38)+0x0)+0x10)
               local sItem2 = readPointer(readPointer(readPointer(addrResource+0x38)+0x0)+0x18)
               if (sItem1 ~= 0) then sItem = readString(readPointer(readPointer(sItem1)+0x10),20) end
               if (sItem2 ~= 0) then sItem = readString(readPointer(readPointer(readPointer(sItem2))+0x10),20) end
               aElem = {sItem, string.format('%X',addrResource)}
            end
            table.insert( aItems, aElem )
        end
        --print("[" .. nCount .. "] " .. kUniqueID .. " ~ " .. string.format('%X',addrResource))
        nCount = nCount + 1
        if (nCount &gt;= rangeList) then
           if ( nChoice &gt; 1 ) then
              table.sort( aItems, function (a,b) return a[1] &lt; b[1] end )
           end
           --print(#aItems .. ' - ' .. aItems[155][1] .. ' - ' .. aItems[155][2])
           bContinue = false
           --break
        end
  end

  sListItems.beginUpdate()
  nCount = 0
  nCount1 = 1
  nResource = 0
  local sPrevItem = ''
  for i = 1, #aItems do
      local addrResource = tonumber(aItems[i][2],16)
      local kUniqueID = readPointer(readPointer(addrResource+0x8)+0x10)
      local sItem = ''
      local sItem1 = readPointer(readPointer(readPointer(addrResource+0x38)+0x0)+0x10)
      local sItem2 = readPointer(readPointer(readPointer(addrResource+0x38)+0x0)+0x18)
      if (sItem1 ~= 0) then sItem = readString(readPointer(readPointer(sItem1)+0x10),20) end
      --if (sItem2 ~= 0) then sItem = readString(readPointer(readPointer(readPointer(sItem2))+0x10),20) end

      local nTotal = readInteger(addrResource)
      local addrCat = readPointer(addrResource+0x38)
      local mRec = mRecPlaceH[kUniqueID]
      local hUniqueID = string.sub(aItems[i][1],1,-6)

      local bDoubleEntries = ' '
      if ( hUniqueID == sPrevItem and sPrevItem ~= '' ) then bDoubleEntries = '*' end

      if ( nChoice == 3  or nChoice == 5) then
         hUniqueID = string.format('%12X',readPointer(readPointer(addrResource+0x8)+0x10))
         bDoubleEntries = ' '
      end
      if (mRec ~= nil) then sItem = mRec[3] end     -- Resource...

      local sDescr = ''
      -- details: check out [Tools ~ Errors &amp; Settings ~ Maintenance scripts ~ Data Container...]
      if (bGetDescr == 1) then
          sDescr = aDescrInv[kUniqueID]
          if (sDescr == nil) then sDescr = '' else sDescr = sDescr[1] end
      end

      local sName = string.format('[%04d][%05X]:  {%14X}   %7d  %s %s   %25s  &lt;%-s&gt;',
                        nCount1,nStruct * nCount,addrResource,nTotal,bDoubleEntries,hUniqueID,sItem,sDescr)
      if (mRec ~= nil) then
         if (nChoice &gt; 1 and nChoice &lt; 4) then
             if nChoice == 3 then sName = sName .. '     = Resource item' end
             sListItems.Text = sListItems.Text .. sName
             --print(sName)
             nCount1 = nCount1 + 1
         end
         writeQword(addrInvTable + 8 * (mRec[2] - 1),addrResource)
         nResource = nResource + 1
         if (nChoice == 1 and nResource &gt;= nResourceMax) then break end
      else
          if (nChoice == 3 and sDescr ~= '') then
             sListItems.Text = sListItems.Text .. sName
             nCount1 = nCount1 + 1
          end
          if (nChoice == 5) then
             sListItems.Text = sListItems.Text .. sName
             nCount1 = nCount1 + 1
          end
          if (nChoice == 4 and bDoubleEntries == '*') then
             sListItems.Text = sListItems.Text .. sName
             nCount1 = nCount1 + 1
             --if (nChoice == 44 and nTotal == 1) then
             --   writeInteger(addrResource,0)
             --end
          end
      end
      sPrevItem = hUniqueID
      nCount = nCount + 1

      if (nCount % 500 == 0) then
          synchronize(function()
              f.ListBox.Items.Text = sListItems.Text
          end)
      end
      if (nCount &gt;= rangeList) then
          --print(nCount .. ' - ' .. rangeList .. ' - ' .. #aItems)
          f.IconTitle.Caption = sMsg
          f.IconInfo.Caption = sInfo
          synchronize(function()
                 f.ListBox.Items.Text = sListItems.Text
          end)
          --if (nCount &gt;= 35) then
         break
      end
  end
  sListItems.endUpdate()
  --print(string.format('%X',addrInventory))
  --luaForm.Font.Name = 'default'
  --luaForm.Font.Size = 10
end

function getItems(addrEcoSysSet,rangeList)
  sListItems.beginUpdate()
  local bContinue = true
  local nCount = 0
  local nCount1 = 0
  while bContinue do
      local addrItem = addrEcoSysSet + 8 * nCount
      --print(string.format('%X',addrItem))
      addrItem = readPointer(addrItem)
      local kUniqueID = string.format('%X',readQword(addrItem+0x10))
      addrItem = readPointer(addrItem)                       -- InventoryItemSettings...
      local addrDescriptive = readPointer(addrItem+0x10)
      addrDescriptive = readPointer(addrDescriptive)         -- InventoryCategory...
      addrDescriptive = readPointer(addrDescriptive+0x10)
      local sItem = readString(addrDescriptive,50)
      addrDescriptive = readPointer(addrDescriptive+0x10)
      addrDescriptive = readPointer(addrDescriptive+0x10)
      local sItemSub = readString(addrDescriptive,50)
      if ( sItemSub == nil ) then sItemSub = '' end

      -- details: check out [Tools ~ Errors &amp; Settings ~ Maintenance scripts ~ Scripts to run...]
      kUniqueID = tonumber(kUniqueID,16)
      local sDescr = ''
      if (bGetDescr == 1) then
          sDescr = aDescrInv[kUniqueID]
          if (sDescr ~= nil) then sDescr = sDescr[1] else sDescr = '' end
      end

      local sName = ''
      if (sSep == ' ') then
          if ( (nChoice == 9 and sDescr ~= '') or nChoice == 10 or nChoice == 11) then
              nCount1 = nCount1 + 1
              sName = string.format('[%04d][%04X]: {%12X}  %12X | %15s  %-70s',
                                nCount1,8 * nCount,addrItem,kUniqueID, string.sub(sItem,1,15), sDescr)
          end
      elseif (sSep == '*-') then
          if ( (nChoice == 9 and sDescr ~= '') or nChoice == 11) then
              nCount1 = nCount1 + 1
              sName = string.format('dq %12X     //[%04d]: %s', kUniqueID, nCount1, sDescr)
          end
      elseif (sSep == '*+') then
          if ( (nChoice == 9 and sDescr ~= '') or nChoice == 11) then
              nCount1 = nCount1 + 1
              sName = string.format('[0x%X] = {"%s"},', kUniqueID, sDescr)
          end
      else
          sName = string.format('[%04d][%04X]:%s%X%s%016s%s%s%s%s',
                                nCount+1,8 * nCount,sSep,addrItem,sSep,kUniqueID,sSep,sItem,sSep,sItemSub)
      end
      sListItems.Text = sListItems.Text .. sName
      --print(sName)

      nCount = nCount + 1
      --rangeList = 10
      if (nCount% 500 == 0 or nChoice == 10) then
          synchronize(function()
              f.ListBox.Items.Text = sListItems.Text
          end)
      end
      if (nCount &gt;= rangeList) then
          f.IconTitle.Caption = sMsg
          f.IconInfo.Caption = sInfo
          if (nChoice == 9 or nChoice == 11) then
              synchronize(function()
                  f.ListBox.Items.Text = sListItems.Text
              end)
          end
          break
      end
  end  -- while...
  sListItems.endUpdate()
end


function CollectItems()
  -- either list all items, or per ItemSet...
  local hSet = 0x0
  if (nChoice == 10) then hSet = 0x24 end
  local addrEcoSysSet = readPointer(getAddress("[pEconomSet]"))
  --print(string.format('%X',addrEcoSysSet))

  local rangeList = readInteger(addrEcoSysSet+0x20+hSet)
  local a = rangeList
  local b = 0x00007FFF
  rangeList = bitOper(a,b,AND)

  --rangeList = 0x200
  addrEcoSysSet = readPointer(addrEcoSysSet+0x18+hSet)
  --print(string.format('%X ~ %d',addrEcoSysSet,rangeList))

  sMsg = 'Special - Full Item List'
  sInfo = ''
  if (nChoice == 10) then sMsg = 'Special - Armor Sets' end
  if (nChoice == 11) then sMsg = 'Special - Full Item List (All)' end

  execStruct = nil
  execRoutine = nil

  -- google: cheat engine Async exec Form invalid window handle
  synchronize(function()
      -- painting form...
      f = IconList
      f.Width = 850
      f.Height = 800
      f.Show()
      f.Caption = 'ACV - Inventory Items...'
      local lBox = f.ListBox
      lBox.Clear()
      local lbTitle = f.IconTitle
      lbTitle.Caption = 'One moment please... processing...'
      local lbInfo = f.IconInfo
      lbInfo.Caption = ''
      local lbHead = f.IconHead
      if (sSep == ' ') then
          lbHead.Caption = '    #   Offset      AddrItem        UniqueID |        Category  Descriptive'
      else
          lbHead.Caption = string.format('#   Offset%sAddrItem%sUniqueID%sCategory%sSubCat',sSep,sSep,sSep,sSep)
      end
      local lbMsg = f.IconMessage
      lbMsg.Caption = "See Readme on how to manage \n and use this info..."
      --lbMsg.Visible = true
      local cbGod = f.GodMode
      f.GodMode.Caption  = 'God Mode:'
      -- hide info...
      f.pCoord.Visible = false
      f.Structure.Visible = false
      f.RecycleBin.Visible = false

      sInfo = string.format('Inventory: %X ~ [%X] ~ {%d}',readPointer(getAddress("[pEconomSet]")),getAddress(myGame),rangeList)
      --local sInfo = string.format('   #   Offset %s     AddrItem   %s         %s       UniqueID  %s                        Category %s       SubCat'
        --        ,sSep,sSep,sSep,sSep,sSep)
  end)

  if (nChoice == 9 or nChoice == 11) then
     local addrItemsList = addrEcoSysSet
     getItems(addrItemsList,rangeList)
     return
  end

  sListItems.beginUpdate()
  local addrItemSetBase = addrEcoSysSet
  local itemVFT = 0
  local bContinue = true
  local nCount = 0
  local nCount1 = 0
  for i=0,rangeList-1 do
        local addrItemSet = addrItemSetBase + 8 * nCount
        addrItemSet = readPointer(addrItemSet)
        if (nCount1 == 0) then itemVFT = readPointer(readPointer(addrItemSet)) end
        local addrItemVFT = readPointer(readPointer(addrItemSet))

        if ( addrItemVFT == itemVFT ) then
           local hUniqueID = string.format('%X',readQword(addrItemSet+0x10))
           local kUniqueID = tonumber(hUniqueID,16)
           local sDescr = ''
           if (bGetDescr == 1) then
              sDescr = aDescrInv[kUniqueID]
              if (sDescr ~= nil) then sDescr = string.rep(" ",12) .. '&lt;' .. sDescr[1] .. '&gt;' else sDescr = '' end
           end

           --print(string.format('%d:  %X  -  %X = %X ',nCount1,addrItemSet,addrItemVFT,itemVFT ))
           local sName = ''
           if (sSep == ' ') then
               sName = string.format('[%02d][%03X] ItemSet: {%12X} ~ %12s %s',nCount1+1,8 * nCount1,addrItemSet,hUniqueID,sDescr)
           else
              sName = string.format('[%02d][%03X]%sItemSet: {%12X}%s%s',nCount1+1,8 * nCount1,sSep,addrItemSet,sSep,hUniqueID)
           end
           sListItems.Text = sListItems.Text .. sName
           --print(sName)

           addrItemSet = readPointer(addrItemSet)
           local rangeList1 = readInteger(addrItemSet+0x28)
           local a = rangeList1
           local b = 0x00007FFF
           rangeList1 = bitOper(a,b,AND)

           local addrItemsList = readPointer(addrItemSet+0x20)
           --print(nCount1 .. ' - ' .. rangeList1)
           if ( rangeList1 &gt; 0) then
              getItems(addrItemsList,rangeList1)
           end
           nCount1 = nCount1 + 1
        end

      --if (addrItemVFT == nil) then addrItemVFT = 999999999 end
      --print(string.format('%d:  %X  -  %X = %X ',nCount,addrItemSet,addrItemVFT,itemVFT ))
      --rangeList = 19
      nCount = nCount + 1
      if (nCount &gt;= rangeList) then
          f.IconTitle.Caption = sMsg
          f.IconInfo.Caption = sInfo
          synchronize(function()
              f.ListBox.Items.Text = sListItems.Text
          end)
         break
      end
  end  -- while bContinue...
  sListItems.endUpdate()
end

--if (nChoice &lt; 0 or nChoice &gt; 10) then return end

sListItems = createStringList()
if (nChoice &gt; 0 and nChoice &lt; 9) then CollectInventory() end
if (nChoice &gt; 8 and nChoice &lt; 12) then CollectItems() end

writeBytes(getAddress("bInvChoice"),1)
sListItems.destroy()


