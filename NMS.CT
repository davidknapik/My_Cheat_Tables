      <Description>"InfJetpack"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

/**
 Desription: Infinate Jetpack
 Type: float
 Value: full == larger than 1 (starting: ~2.5)
 empty == 0
 size depends on any jetpack improvements, eg. '7.496'
**/
