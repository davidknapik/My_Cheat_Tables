    <CheatEntry>
      <ID>22</ID>
      <Description>"FindAddress"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

// Find portal address of system
// 1:042:96:FCF:0C6
// Once you find this address in the Memory Viewer
// Run the 'Find out what addresses this instuction addresses'
// Show register states and grab the RDX address, paste into structure as starting address
//
// Planet Index
// SolarSystem Index
// VoxelX
// VoxelY
// VoxelZ

aobScanmodule(aob_galaddress, NMS.exe, 8B 02 89 01 8B 42 04 89 41 04 8B 42 08 89 41 08 8B 42 0C 89 41 0C 8B 42 10 89 41 10 48 8B C1 C3)
registersymbol(aob_galaddress)

//aob_galaddress+5:
//db 90 90 90 90


/*

NMS.exe+1B16980 - 8B 02                 - mov eax,[rdx]
NMS.exe+1B16982 - 89 01                 - mov [rcx],eax
NMS.exe+1B16984 - 8B 42 04              - mov eax,[rdx+04]
NMS.exe+1B16987 - 89 41 04              - mov [rcx+04],eax
NMS.exe+1B1698A - 8B 42 08              - mov eax,[rdx+08]
NMS.exe+1B1698D - 89 41 08              - mov [rcx+08],eax
NMS.exe+1B16990 - 8B 42 0C              - mov eax,[rdx+0C]
NMS.exe+1B16993 - 89 41 0C              - mov [rcx+0C],eax
NMS.exe+1B16996 - 8B 42 10              - mov eax,[rdx+10]
NMS.exe+1B16999 - 89 41 10              - mov [rcx+10],eax
NMS.exe+1B1699C - 48 8B C1              - mov rax,rcx
NMS.exe+1B1699F - C3                    - ret


*/


[DISABLE]
//code from here till the end of the code will be used to disable the cheat
//aob_galaddress+5:
//db F3 0F 5C C6
unregistersymbol(aob_galaddress)

</AssemblerScript>
    </CheatEntry>
