<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>5</ID>
      <Description>"NoStamina"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
// Stamina
// Type: Float
// Value: 100 (full)

// Food
// Type: float
// Value: 100 (full)

// Several values will come up.
// To find the proper one, hold each address indivudally until none of the others change
aobscanmodule(aob_stamina, SengokuDynasty-Win64-Shipping.exe, CC F3 0F 11 49 08 C3)
registersymbol(aob_stamina)

aob_stamina+1:
db 90 90 90 90 90

/*
SengokuDynasty-Win64-Shipping.exe+3B7B2A0:
7FF7E4D0B29E - CC - int 3
7FF7E4D0B29F - CC - int 3
7FF7E4D0B2A0 - F3 0F11 49 08  - movss [rcx+08],xmm1 &lt;&lt;
7FF7E4D0B2A5 - C3 - ret
7FF7E4D0B2A6 - CC - int 3
*/
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
aob_stamina+1:
db F3 0F 11 49 08
</AssemblerScript>
      <Hotkeys>
        <Hotkey>
          <Action>Toggle Activation</Action>
          <Keys>
            <Key>113</Key>
          </Keys>
          <ID>0</ID>
        </Hotkey>
      </Hotkeys>
    </CheatEntry>
    <CheatEntry>
      <ID>7</ID>
      <Description>"No description"</Description>
      <VariableType>4 Bytes</VariableType>
      <Address>2A955F71788</Address>
    </CheatEntry>
