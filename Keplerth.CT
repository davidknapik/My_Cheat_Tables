    <CheatEntry>
      <ID>11</ID>
      <Description>"INF Health"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscan(health,89 87 90 01 00 00 48 63) // should be unique
alloc(newmem,$100,1AA79DB3)

label(code)
label(return)

newmem:
cmp [rdi+0124],0
je code
mov eax,[rdi+018C]
mov [rdi+00000190],eax
jmp return

code:
  mov [rdi+00000190],eax
  jmp return

health:
  jmp newmem
  nop
return:
registersymbol(health)

[DISABLE]

health:
  db 89 87 90 01 00 00

unregistersymbol(health)
dealloc(newmem)
</AssemblerScript>
