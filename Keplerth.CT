      <ID>22</ID>
      <Description>"Dont deduct gene inventory"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// gene inventory: 4 bytes
// drop gene material without decrementing
// search for gene inventory (preferably something that has qty &gt; 3
// drop one and scan again
// find out what writes to that address and nop it

