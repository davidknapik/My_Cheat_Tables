[ENABLE]
define(battribute,mrattr) // should be unique
alloc(newmem,$1000,battribute)
alloc(battributec,11)
alloc(battributei,8)
registersymbol(battributei)
registerSymbol(battribute battributec)
label(code return)

battributec:
  readmem(battribute,11)
  
newmem:
  mov [battributei],rax
code:
  readmem(battribute,11)
  jmp return

battribute:
  jmp newmem
  nop 6
return:

[DISABLE]
battribute:
  readmem(battributec,11)
