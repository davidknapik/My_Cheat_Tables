[ENABLE]
define(bplayer,mrcontrol) // should be unique
alloc(newmem,$1000,bplayer)
alloc(bplayerc,7)
alloc(bplayeri,8)
registersymbol(bplayeri)
registerSymbol(bplayer bplayerc)
label(code return)

bplayerc:
  readmem(bplayer,7)
  
newmem:
  mov [bplayeri],rax
code:
  readmem(bplayer,7)
  jmp return

bplayer:
