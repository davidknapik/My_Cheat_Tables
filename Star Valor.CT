memrec.Color=0x000080ff
-------------- A.B.G.R
ShipTweakHull = createTimer()
ShipTweakHull.setInterval(10)
ShipTweakHull.OnTimer = function()
    writeFloat('[["_Player"]+54]+38',100000000)--baseHP
	writeFloat('[[["_Player"]+54]+7c]+20',100000000)--baseEnergy
	writeFloat('[[["_Player"]+54]+7c]+28',100000000)--energyGenerated
	writeFloat('[[["_Player"]+54]+7c]+34',0)--energyExpend
	writeFloat('[[["_Player"]+54]+7c]+38',100000000)--baseShield
	writeFloat('[[["_Player"]+54]+7c]+40',100000000)--shieldRecharge
	writeFloat('[[["_Player"]+54]+7c]+44',100000000)--shieldAbsorb
end

[DISABLE]
ShipTweakHull.destroy()
