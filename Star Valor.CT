    <CheatEntry>
      <ID>116958</ID>
      <Description>"FreeTrade"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

aobscan(aob_freetrade, D9 04 24 83 C4 04 DE C9 DE E9 D9 58 34 )
registersymbol(aob_freetrade)


aob_freetrade+a:
db 90 90 90

/*
Market:BuyMarketItem+37a - D9 04 24              - fld dword ptr [esp]
Market:BuyMarketItem+37d - 83 C4 04              - add esp,04 { 4 }
Market:BuyMarketItem+380 - DEC9                  - fmulp st(1),st(0)
Market:BuyMarketItem+382 - DEE9                  - fsubp st(1),st(0)
Market:BuyMarketItem+384 - D9 58 34              - fstp dword ptr [eax+34]   &lt;&lt;
Market:BuyMarketItem+387 - 8B 43 0C              - mov eax,[ebx+0C]
Market:BuyMarketItem+38a - 3D 03000000           - cmp eax,00000003 { 3 }

*/

 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
aob_freetrade+a:
db D9 58 34

</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>116961</ID>
      <Description>"FreeAmmo"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

aobscan(aob_freeammo, 7C 13 8B 45 08 8B 48 0C 2B 4D 0C 89 48 0C )
registersymbol(aob_freeammo)


aob_freeammo+8:
db 90 90 90

/*
AmmoBuffer:PayAmmo+c - 3B 45 0C              - cmp eax,[ebp+0C]
AmmoBuffer:PayAmmo+f - 7C 13                 - jl AmmoBuffer:PayAmmo+24
AmmoBuffer:PayAmmo+11- 8B 45 08              - mov eax,[ebp+08]
AmmoBuffer:PayAmmo+14- 8B 48 0C              - mov ecx,[eax+0C]
AmmoBuffer:PayAmmo+17- 2B 4D 0C              - sub ecx,[ebp+0C]
AmmoBuffer:PayAmmo+1a- 89 48 0C              - mov [eax+0C],ecx
AmmoBuffer:PayAmmo+1d- B8 01000000           - mov eax,00000001 { 1 }
AmmoBuffer:PayAmmo+22- EB 02                 - jmp AmmoBuffer:PayAmmo+26
AmmoBuffer:PayAmmo+24- 33 C0                 - xor eax,eax
AmmoBuffer:PayAmmo+26- C9                    - leave


*/

 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
aob_freeammo+8:
db 2B 4D 0C

</AssemblerScript>
