memrec.Color=0x000080ff
-------------- A.B.G.R
Tweak = createTimer()
Tweak.setInterval(10)
Tweak.OnTimer = function()
	writeFloat('[[["_Player"]+54]+7c]+60',10)--miningSpeedBonus
	writeFloat('[[["_Player"]+54]+7c]+64',5)--miningLootBonus
	writeFloat('[[["_Player"]+54]+7c]+68',5)--specialMetalBonus
	writeFloat('[[["_Player"]+54]+7c]+6c',5)--scavengeLootBonus
--	writeBytes('[[["_Player"]+54]+78]+8d',1)--canRoll
end

[DISABLE]
Tweak.destroy()
