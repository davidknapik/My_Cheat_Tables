                <CheatEntry>
                  <ID>116616</ID>
                  <Description>"Crafting"</Description>
                  <Options moHideChildren="1"/>
                  <GroupHeader>1</GroupHeader>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>116531</ID>
                      <Description>"Crafting Tweak ( DISABLE OUTSIDE CRAFTING )"</Description>
                      <Color>008000</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$lua}
if syntaxcheck then return end
LaunchMonoDataCollector()
-----------------------
memrec.Color=0x000080ff
-------------- A.B.G.R

[ENABLE]
memrec.Color=0x0008000
CraftingTweak = createTimer()
CraftingTweak.setInterval(10)
CraftingTweak.OnTimer = function()
    writeInteger("[[[_Crafting]+14]+20]+c",0)
	writeInteger("[[[_Crafting]+14]+1c]+8",4294967295)--ffffffff (No ammo)
    writeInteger("[[[_Crafting]+14]+1c]+c",0)
	writeFloat("[[_Crafting]+14]+60",0.001)--weapon space
    writeFloat("[[_Crafting]+14]+64",0)
    writeFloat("[[_Crafting]+14]+68",0)
    writeBytes("[[_Crafting]+14]+6c",1)
    writeBytes("[[_Crafting]+14]+6d",1)
end

[DISABLE]

CraftingTweak.destroy()
if syntaxcheck then return end
-----------------------
memrec.Color=0x00008000
-------------- A.B.G.R
</AssemblerScript>
