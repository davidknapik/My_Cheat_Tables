<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"aob_nodrop"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>// Don't decrement dropped items


[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
aobScanmodule(aob_nodrop, witcher3.exe, 8B 41 54 41 3B C6 76 0D 41 2B C6 BA 03 00 00 00 )
registersymbol(aob_nodrop)

aob_nodrop+8:
//db 44 01 F0
db 90 90 90

 /*
witcher3.exe+19F7DC9 - A8 01                 - test al,01 { 1 }
witcher3.exe+19F7DCB - 74 15                 - je witcher3.exe+19F7DE2
witcher3.exe+19F7DCD - 8B 41 54              - mov eax,[rcx+54]
witcher3.exe+19F7DD0 - 41 3B C6              - cmp eax,r14d
witcher3.exe+19F7DD3 - 76 0D                 - jna witcher3.exe+19F7DE2

witcher3.exe+19F7DD5 - 41 2B C6              - sub eax,r14d

witcher3.exe+19F7DD8 - BA 03000000           - mov edx,00000003 { 3 }
witcher3.exe+19F7DDD - 89 41 54              - mov [rcx+54],eax
witcher3.exe+19F7DE0 - EB 3D                 - jmp witcher3.exe+19F7E1F
witcher3.exe+19F7DE2 - F6 C2 60              - test dl,60 { 96 }

 */


 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
aob_nodrop+8:
db 41 2B C6
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>2</ID>
      <Description>"aob_nobomb"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>// Don't decrement bombs


[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
aobScanmodule(aob_nobomb, witcher3.exe, C7 00 02 00 00 00 8B 4C 24 20 89 48 04 48 8B 5C 24 40)
registersymbol(aob_nobomb)

aob_nobomb+a:
db 90 90 90

 /*
witcher3.exe+19DCE11 - 8B 44 24 58           - mov eax,[rsp+58]
witcher3.exe+19DCE15 - 48 8D 54 24 24        - lea rdx,[rsp+24]
witcher3.exe+19DCE1A - 41 B0 01              - mov r8b,01 { 1 }
witcher3.exe+19DCE1D - 89 44 24 24           - mov [rsp+24],eax
witcher3.exe+19DCE21 - E8 0AE7B2FE           - call witcher3.exe+50B530
witcher3.exe+19DCE26 - C7 00 02000000        - mov [rax],00000002 { 2 }
witcher3.exe+19DCE2C - 8B 4C 24 20           - mov ecx,[rsp+20]

witcher3.exe+19DCE30 - 89 48 04              - mov [rax+04],ecx

witcher3.exe+19DCE33 - 48 8B 5C 24 40        - mov rbx,[rsp+40]
witcher3.exe+19DCE38 - 48 8B 74 24 50        - mov rsi,[rsp+50]
witcher3.exe+19DCE3D - 48 83 C4 30           - add rsp,30 { 48 }
witcher3.exe+19DCE41 - 5F                    - pop rdi


 */


 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
aob_nobomb+a:
db 89 48 04
</AssemblerScript>
      <Hotkeys>
        <Hotkey>
          <Action>Toggle Activation</Action>
          <Keys>
            <Key>113</Key>
          </Keys>
          <ID>0</ID>
        </Hotkey>
      </Hotkeys>
    </CheatEntry>
    <CheatEntry>
      <ID>4</ID>
      <Description>"*aob_nopoints"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>// Don't decrement skill points
// not working, found the points available, however nop the code hangs the program

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
aobScanmodule(aob_nopoints, witcher3.exe, 48 8B 0F 41 FF 14 C6 48 FF 47 30 8B 03 2B 44 24 50 89 03 48 85 F6 74 02 89 06)
registersymbol(aob_nopoints)

aob_nopoints+d:
db 90 90 90 90

 /*
witcher3.exe+20055B1 - 48 8B 0F              - mov rcx,[rdi]
witcher3.exe+20055B4 - 41 FF 14 C6           - call qword ptr [r14+rax*8]
witcher3.exe+20055B8 - 48 FF 47 30           - inc qword ptr [rdi+30]
witcher3.exe+20055BC - 8B 03                 - mov eax,[rbx]

witcher3.exe+20055BE - 2B 44 24 50           - sub eax,[rsp+50]

witcher3.exe+20055C2 - 89 03                 - mov [rbx],eax
witcher3.exe+20055C4 - 48 85 F6              - test rsi,rsi
witcher3.exe+20055C7 - 74 02                 - je witcher3.exe+20055CB
witcher3.exe+20055C9 - 89 06                 - mov [rsi],eax



 */


 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
aob_nopoints+d:
db 2B 44 24 50
</AssemblerScript>
      <Hotkeys>
        <Hotkey>
          <Action>Toggle Activation</Action>
          <Keys/>
          <ID>0</ID>
        </Hotkey>
      </Hotkeys>
    </CheatEntry>
