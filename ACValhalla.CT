<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>2</ID>
      <Description>"FreeArrows"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
// Description: Stamina
// Type: 4 byte
// Default Value: 14 (number of arrows)
//
// Also affects purchasing and upgrading equipment
// Note: if upgrade requires exactly the number in inventory, will go to 0
//
aobScanmodule(aob_arrows, ACValhalla.exe, 0F 46 45 3F 44 2B C0 44 89 03)
registersymbol(aob_arrows)


aob_arrows+4:
   db 90 90 90

/**

 ACValhalla.exe+2572C97:
7FF6D4492C90 - 0F46 45 3F  - cmovbe eax,[rbp+3F]
7FF6D4492C94 - 44 2B C0  - sub r8d,eax
7FF6D4492C97 - 44 89 03  - mov [rbx],r8d &lt;&lt;
7FF6D4492C9A - 75 0C - jne ACValhalla.exe+2572CA8
7FF6D4492C9C - 41 8B D4  - mov edx,r12d

*/

[DISABLE]
//code from here till the end of the code will be used to disable the cheat

aob_arrows+4:
   db 44 2B C0
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>4</ID>
      <Description>"Stamina"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
// Description: Stamina
// Type: Float
// Default Value: 100
aobScanmodule(aob_stamina, ACValhalla.exe, 48 8B 43 18 F3 0F 5F C2 F3 0F 59 C6 F3 0F 5C C8 F3 0F 5F CA)
registersymbol(aob_stamina)


aob_stamina+c:
   db 90 90 90 90

/**

ACValhalla.exe+24C178B - 48 8B 43 18           - mov rax,[rbx+18]
ACValhalla.exe+24C178F - F3 0F5F C2            - maxss xmm0,xmm2
ACValhalla.exe+24C1793 - F3 0F59 C6            - mulss xmm0,xmm6
ACValhalla.exe+24C1797 - F3 0F5C C8            - subss xmm1,xmm0
ACValhalla.exe+24C179B - F3 0F5F CA            - maxss xmm1,xmm2
ACValhalla.exe+24C179F - F3 0F11 4B 0C         - movss [rbx+0C],xmm1 &lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;
ACValhalla.exe+24C17A4 - 80 78 3C 00           - cmp byte ptr [rax+3C],00
ACValhalla.exe+24C17A8 - 75 10                 - jne ACValhalla.exe+24C17BA


*/

[DISABLE]
//code from here till the end of the code will be used to disable the cheat

aob_stamina+c:
   db F3 0F 5C C8
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>5</ID>
      <Description>"*Adrenalin"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
// Description: Adrenalin
// Type: 4 Byte
// Default Value: 100
aobScanmodule(aob_adrenalin, ACValhalla.exe, 48 8B 43 18 F3 0F 5F C2 F3 0F 59 C6 F3 0F 5C C8 F3 0F 5F CA)
registersymbol(aob_adrenalin)


aob_adrenalin+c:
   db 90 90 90 90

/**

ACValhalla.exe+24C178B - 48 8B 43 18           - mov rax,[rbx+18]
ACValhalla.exe+24C178F - F3 0F5F C2            - maxss xmm0,xmm2
ACValhalla.exe+24C1793 - F3 0F59 C6            - mulss xmm0,xmm6
ACValhalla.exe+24C1797 - F3 0F5C C8            - subss xmm1,xmm0
ACValhalla.exe+24C179B - F3 0F5F CA            - maxss xmm1,xmm2
ACValhalla.exe+24C179F - F3 0F11 4B 0C         - movss [rbx+0C],xmm1 &lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;
ACValhalla.exe+24C17A4 - 80 78 3C 00           - cmp byte ptr [rax+3C],00
ACValhalla.exe+24C17A8 - 75 10                 - jne ACValhalla.exe+24C17BA


*/

[DISABLE]
//code from here till the end of the code will be used to disable the cheat

aob_adrenalin+c:
   db F3 0F 5C C8
</AssemblerScript>
    </CheatEntry>
