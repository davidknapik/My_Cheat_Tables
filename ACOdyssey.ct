    <CheatEntry>
      <ID>6</ID>
      <Description>"No Cost Purchases"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// no cost blacksmith
// gold amount stored 4 bytes
//code from here to '[DISABLE]' will be used to enable the cheat
//aobscan(cheat01,41 0F 46 C4 44 2B C0 44 89 03)
aobScanmodule(cheat01, ACOdyssey.exe, 41 0F 46 C4 44 2B C0 44 89 03)

label(_cheat01)
registersymbol(_cheat01)

cheat01+4:
_cheat01:
db 90 90 90


/**
7FF7803A7F8D - 41 0F46 C4  - cmovbe eax,r12d
7FF7803A7F91 - 44 2B C0  - sub r8d,eax
7FF7803A7F94 - 44 89 03  - mov [rbx],r8d &lt;&lt;
7FF7803A7F97 - 75 0B - jne ACOdyssey.AK::MemoryMgr::StartProfileThreadUsage+3594
7FF7803A7F99 - 8B D7  - mov edx,edi
**/
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat

_cheat01+4:
db 44 2B C0

</AssemblerScript>
