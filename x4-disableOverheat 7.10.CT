    <CheatEntry>
      <ID>115</ID>
      <Description>"Open Map view right Info tab then select a ship (DON'T LOCK)"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">[ENABLE]
aobscanmodule(ship,$process,74 ?? F3 0F 10 ?? ?? ?? 00 00 0F 57 C9 F3 0F 5A C8)
alloc(newmem,$1000,ship)

label(shipPtr)
label(code)
label(return)

newmem:
  mov [shipPtr],rbx
code:
  xorps xmm1,xmm1
  cvtss2sd xmm1,xmm0
  jmp return

align 10
shipPtr:
  dq 0

ship+0A:
  jmp newmem
  nop 2
return:
registersymbol(ship)
registersymbol(shipPtr)

[DISABLE]
ship+0A:
  db 0F 57 C9 F3 0F 5A C8
unregistersymbol(ship)
unregistersymbol(shipPtr)
dealloc(newmem)

