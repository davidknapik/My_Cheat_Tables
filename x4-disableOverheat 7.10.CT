              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : X4.exe
  Version: 
  Date   : 2025-01-08
  Author : super

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(INJECT,X4.exe,58 18 89 50 10 55 56) // should be unique
alloc(newmem,$1000,INJECT)

label(exit)
label(code)
label(return)

newmem:

  push rbx
  mov rbx, [rbp+20]
  cmp rbx ,[shipPtr]
  je exit
  mov rbx, [rbp+2C0]
  cmp rbx ,[shipPtr]
  je exit
  mov rbx, [rbp+278]
  cmp rbx ,[shipPtr]
  je exit
  mov rbx, [rbp+2D8]
  cmp rbx ,[shipPtr]
  je exit
  mov rbx, [rbp+138]
  cmp rbx ,[shipPtr]
  je exit

code:
  pop rbx
  mov [rax+10],edx
  push rbp
  push rsi
  jmp return

exit:
  mov edx,#0
  jmp code


INJECT+02:
  jmp newmem
return:
registersymbol(INJECT)

[DISABLE]

INJECT+02:
  db 89 50 10 55 56

unregistersymbol(INJECT)
dealloc(newmem)

