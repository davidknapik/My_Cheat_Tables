                <CheatEntry>
                  <ID>329</ID>
                  <Description>"Max Up All Crew Skills"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$lua}
local ship = readPointer("shipPtr")
local last = readPointer(ship + 0x448)
local crew = readPointer(ship + 0x440)
local i = 0
if crew == nil or crew &lt;= 0 then
  return
end
while crew &lt; last do
  writeInteger(crew + 0x14, 0x00FFFFF0)
  crew = crew + 0x20
  i = i + 1
  if i &gt; 500 then
    return
  end
end
{$asm}
assert(true)
[DISABLE]
</AssemblerScript>
