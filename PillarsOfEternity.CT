    <CheatEntry>
      <ID>13</ID>
      <Description>"README"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
[DISABLE]
/*

Experience
Type: 4 bytes
** can put large number in and player will go through as many level-up's as needed
Level 12: 66000

Money
Type: Float
Search value between 1 lower to 1 higher
Best to do in a tavern the first time


*/
</AssemblerScript>
